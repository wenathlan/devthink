# getry gateway environment variables
# copy to .env and fill in your values

# database url — sqlite local file or libsql remote
# local sqlite (default for dev)
DATABASE_URL="file:./db/custom.db"
# remote libsql (for vercel netlify production)
# DATABASE_URL="libsql:https://your-turso-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# zai token — required for the v1 replica token plus chat id bypass
# get from z ai internal api
ZAI_TOKEN=""

# nvidia api key — required for the nvidia nim rotation
# comma separated for key rotation
# get from https://build.nvidia.com
NVIDIA_API_KEY=""

# openrouter api key — required for the openrouter free models
# free signup at https://openrouter.ai
OPENROUTER_API_KEY=""

# babel town — paused no key needed
# BABEL_KEY=""
