// Gateway Prisma schema — V5 canonical with libsql adapter
// Supports serverless/edge deployment (Vercel/Netlify) via DATABASE_URL=libsql:// or file://
//
// family sync contract: a table of the same kind carries the same columns
// and the same pointers in every application that holds the kind — identity
// pointers are text, counts are 32-bit ints, time is datetime or iso text,
// and byte-scale pointers are 64-bit BigInt. The gateway kinds (ChatMessage,
// NvidiaKey, TownKey, ApiKey) moved here from devthink/schema.prisma in the
// wave/ownership.getry split: the gateway owns its own datasource sqlite
// from this wave on, and the master ChatMessage surface lives beside the
// engine that writes it. getry additionally carries the SessionContext and
// OnboardingState kinds its own lanes consume.

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

/// every interaction log across v1 zai v2 babel v3 nvidia v4 opencode kilo v5 openrouter
model ChatMessage {
  id                  String  @id @default(cuid())
  active              Boolean @default(true)
  allparams           String?
  allresponse         String?
  annotations         String?
  autofixapplied      String?
  cachedtokens        Int     @default(0)
  chattemplatekwargs  String?
  completedat         DateTime?
  completion          String?
  completiontokens    Int?
  content             String  @default("")
  contextshared       Boolean @default(false)
  devthinkcontext     Int?
  devthinkoutput      Int?
  endpoint            String?
  error               String?
  errorcode           String?
  errormessage        String?
  finishreason        String?
  firsttokenms        Int     @default(0)
  frequencypenalty    Float?
  httpstatus          Int?
  inputtokens         Int     @default(0)
  ip                  String  @default("unknown")
  ipused              String  @default("unknown")
  keyid               String?
  keylabel            String?
  latencyms           Int     @default(0)
  lastused            DateTime?
  logprobs            String?
  maxtokens           Int?
  messagenumber       Int?
  model               String?
  modelvariant        String?
  objectid            String?
  outputtokens        Int     @default(0)
  presencepenalty     Float?
  prompttokens        Int     @default(0)
  provider            String?
  reasoningcontent    String?
  reasoningeffort     String?
  reasoninglevel      String?
  requestid           String?
  responseid          String?
  responseheaders     String?
  retries             Int     @default(0)
  role                String  @default("assistant")
  rotationcount       Int     @default(0)
  rotationindex       Int?
  route               String?
  seed                Int?
  servicetier         String?
  sessionid           String?
  sources             String?
  startedat           DateTime?
  status              String  @default("active")
  stop                String?
  stopsequence        String?
  stream              Boolean @default(false)
  streammode          Boolean @default(false)
  version             String?
  twocalls            Boolean?
  systemfingerprint   String?
  temperature         Float?
  thinking            String?
  thinkingbudget      Int?
  thinkingenabled     Boolean @default(true)
  thinkinglevel       String?
  thinkingtokens      Int     @default(0)
  toolcalls           String?
  topk                Int?
  topp                Float?
  totaltokens         Int     @default(0)
  useragent           String?
  useragentforged     String?
  createdat           DateTime @default(now())
  updatedat           DateTime @updatedAt

  @@index([sessionid])
  @@index([route])
  @@index([model])
  @@index([provider])
  @@index([status])
  @@index([createdat])
}

/// nvidia api key management with rotation
model NvidiaKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  rateLimitRemaining Int?
  rateLimitResetAt  DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([active])
  @@index([status])
}

/// babel town key management
model TownKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([active])
  @@index([status])
}

/// api key management for other providers
model ApiKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  provider        String
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([provider])
  @@index([active])
  @@index([status])
}

/// SessionContext — per-(sessionId, provider) rotation state for devthink meta-model
/// each version (zai, nvidia, free) has its own rotation index persisted here
model SessionContext {
  id                String   @id @default(cuid())
  sessionId         String
  provider          String   @default("zai")  /// zai | nvidia | babeltown | free | openrouter
  route             String?
  model             String?
  modelVariant      String?
  inputSummary      String?
  outputSummary     String?
  thinkingSummary   String?
  messageCount      Int      @default(0)
  lastMessageAt     DateTime?
  contextWindow     Int?
  rotationIndex     Int      @default(0)
  thinkingLevel     String?
  thinkingBudget    Int?
  thinkingEnabled   Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sessionId, provider])
  @@index([provider])
  @@index([route])
  @@index([lastMessageAt])
}

/// the onboarding state of one visitor — the entry-flow gates catalogued on
/// the database (intro → onboarding → the platform): the browser accessor
/// (onboardingstate.ts) rides GET/POST /api/v1/onboarding against this table,
/// the sqlite mirror lives in db.ts (onboarding_states)
model OnboardingState {
  id             Int      @id @default(autoincrement())
  visitor        String   @unique
  introseen      Boolean  @default(false)
  onboardingseen Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}
