{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "outDir": "dist/types",
    "rootDir": ".."
  },
  "include": [
    "thinking.ts",
    "engine.ts",
    "llm.ts",
    "streaming.ts",
    "models.ts",
    "request.ts",
    "providers.ts",
    "antigravity.ts",
    "oauth.ts",
    "accounts.ts",
    "project.ts",
    "quota.ts",
    "recovery.ts",
    "fingerprint.ts",
    "search.ts",
    "utils.ts",
    "versionregistry.ts",
    "intelligence.ts",
    "json.ts",
    "jsonpolicy.ts",
    "jsonschema.ts",
    "gatewayconfig.ts",
    "gatewayviewconfig.ts",
    "gatewayprobe.ts",
    "gatewaysmoke.ts",
    "nodeshim.ts",
    "types.ts",
    "constants.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "tests", "Sol"]
}
