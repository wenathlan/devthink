{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "outDir": "dist/types",
    "rootDir": "..",
    "types": ["node"],
    "typeRoots": ["../devthink/node_modules/@types"],
    "paths": {
      "z-ai-web-dev-sdk": [
        "../devthink/node_modules/z-ai-web-dev-sdk/dist/index.d.ts"
      ],
      /* the hono seat bridge of the declaration pass: the getry transport
       * (server.ts, the ownership wave) imports the hono family, and the
       * devthink-side lanes that run this declaration emit never install
       * the getry tree - the resolution walks the devthink install the
       * same way every sibling bridge does (the getry-local install and
       * the getry lanes answer their own node_modules first when present). */
      "hono": ["../devthink/node_modules/hono/dist/types/index.d.ts"],
      "hono/cors": ["../devthink/node_modules/hono/dist/types/middleware/cors/index.d.ts"],
      "@hono/node-server": ["../devthink/node_modules/@hono/node-server/dist/index.d.mts"],
      "@hono/node-server/serve-static": ["../devthink/node_modules/@hono/node-server/dist/serve-static.d.mts"],
      "@/*": ["./sol/*", "./*"],
      "@wenathlan/vault/labelstore": ["../vault/labelstore.ts"],
      /* the modality registry bridge of the ownership wave
       * (wave/ownership.getry), mirrored from the devthink side: the moved
       * engine graph leans on the os server seam whose sandbox lane reads
       * the saddle catalog through the published specifier, and the
       * installed 2.1.6 envelope carries no ./modalityregistry export —
       * the typecheck resolves the monorepo source the same way the
       * vitest bridge does. retires when saddle 2.1.7 publishes the
       * export entry. */
      "@wenathlan/saddle/modalityregistry": ["../saddle/modalityregistry.ts"],
      "@wenathlan/devthink/config": ["../devthink/config.ts"],
      "@wenathlan/devthink/constants": ["../devthink/constants.ts"],
      "@wenathlan/devthink/core": ["../devthink/core.ts"],
      "@wenathlan/devthink/data": ["../devthink/data.ts"],
      "@wenathlan/devthink/http": ["../devthink/http.ts"],
      "@wenathlan/devthink/memory": ["../devthink/memory.ts"],
      "@wenathlan/devthink/policy": ["../devthink/policy.ts"],
      /* the queue bridge of the retry.backoff owner: the llm source walks
       * the published queue specifier and the declaration pass resolves it
       * to the monorepo source the sibling app carries. */
      "@wenathlan/devthink/queue": ["../devthink/queue.ts"],
      "@wenathlan/devthink/protocol": ["../devthink/protocol.ts"],
      "@wenathlan/devthink/security": ["../devthink/security.ts"],
      /* the @wenathlan/devthink/server self bridge was DELETED with the
       * final double move of the gateway ownership wave (steps 4+5): the
       * last getry consumers of the os server seam were the property lane
       * (flipped in step 3) and the provider console barrel (moved to this
       * app's providercli.ts, whose imports answer from in-package
       * relatives) — nothing in getry imports the os server entry anymore,
       * so the reverse-edge bridge retired with them. */
      "@wenathlan/devthink/storage": ["../devthink/storage.ts"],
      "@wenathlan/devthink/tools": ["../devthink/tools.ts"],
      "@wenathlan/devthink/types": ["../devthink/types.ts"],
      /* the getry self bridges of the ownership wave (wave/ownership.getry),
       * mirrored from the devthink side: the os sources the moved graph
       * consumes through the devthink bridges above import the gateway
       * modules back through the published specifiers
       * ("@wenathlan/getry/engine" and siblings), and the published
       * envelope still answers from the 2.0.154 face that carries only
       * ./thinking — so every gateway specifier resolves to this app's own
       * source here (the one owner of the moved modules) until the
       * published envelope carries the export surfaces the wave added. */
      "@wenathlan/getry/thinking": ["./thinking.ts"],
      "@wenathlan/getry/engine": ["./engine.ts"],
      "@wenathlan/getry/llm": ["./llm.ts"],
      "@wenathlan/getry/streaming": ["./streaming.ts"],
      "@wenathlan/getry/models": ["./models.ts"],
      "@wenathlan/getry/request": ["./request.ts"],
      "@wenathlan/getry/providers": ["./providers.ts"],
      "@wenathlan/getry/antigravity": ["./antigravity.ts"],
      "@wenathlan/getry/oauth": ["./oauth.ts"],
      "@wenathlan/getry/accounts": ["./accounts.ts"],
      /* the auth self bridge of the gateway ownership wave
       * (wave/ownership.gateway): the devthink server compat shim speaks
       * the moved auth family back through the published specifier
       * ("@wenathlan/getry/auth"), and this program pulls the shim in
       * through the devthink server bridge — the specifier resolves to
       * this app's own source (the one owner of the moved family). */
      "@wenathlan/getry/auth": ["./auth.ts"],
      /* the server self bridge of the gateway ownership wave
       * (wave/ownership.gateway, step 3 — the transport move): the sse/ndjson
       * stream pipeline, the gateway route loop, the console static roots,
       * the transport boot (main/runserver) and the gateway config loader
       * moved to this app's server.ts, and every consumer that speaks the
       * published specifier ("@wenathlan/getry/server") resolves it to this
       * app's own source — the one owner of the moved transport. */
      "@wenathlan/getry/server": ["./server.ts"],
      /* the cli self bridge of the gateway ownership wave
       * (wave/ownership.gateway, step 4 — the console cli move): the gateway
       * console cli family moved to this app's cli.ts, and every consumer
       * that speaks the published specifier ("@wenathlan/getry/cli") — the
       * devthink server compat shim and the devthink router — resolves it
       * to this app's own source: the one owner of the moved console. */
      "@wenathlan/getry/cli": ["./cli.ts"],
      /* the providercli self bridge of the gateway ownership wave
       * (wave/ownership.gateway, step 5 — the provider console move): the
       * provider account console family moved to this app's providercli.ts,
       * and every consumer that speaks the published specifier
       * ("@wenathlan/getry/providercli") — the devthink server compat shim
       * and the devthink router — resolves it to this app's own source:
       * the one owner of the moved console. */
      "@wenathlan/getry/providercli": ["./providercli.ts"],
      /* the oslabels bridge of the ownership wave: the moved provider
       * console reads the paired label catalog through the published os
       * specifier ("@wenathlan/devthink/oslabels"), and this program
       * resolves it to the monorepo source the sibling app carries — the
       * label catalog is never duplicated inside getry. */
      "@wenathlan/devthink/oslabels": ["../devthink/oslabels.ts"],
      "@wenathlan/getry/project": ["./project.ts"],
      "@wenathlan/getry/quota": ["./quota.ts"],
      "@wenathlan/getry/recovery": ["./recovery.ts"],
      "@wenathlan/getry/fingerprint": ["./fingerprint.ts"],
      "@wenathlan/getry/search": ["./search.ts"],
      "@wenathlan/getry/utils": ["./utils.ts"],
      "@wenathlan/getry/versionregistry": ["./versionregistry.ts"],
      "@wenathlan/getry/intelligence": ["./intelligence.ts"],
      "@wenathlan/getry/json": ["./json.ts"],
      "@wenathlan/getry/jsonpolicy": ["./jsonpolicy.ts"],
      "@wenathlan/getry/jsonschema": ["./jsonschema.ts"],
      "@wenathlan/getry/gatewayconfig": ["./gateway.ts"],
      "@wenathlan/getry/gatewayviewconfig": ["./gateway.ts"],
      "@wenathlan/getry/gatewayprobe": ["./gatewayprobe.ts"],
      "@wenathlan/getry/gatewaysmoke": ["./gatewaysmoke.ts"],
      "@wenathlan/getry/nodeshim": ["./nodeshim.ts"],
      "@wenathlan/getry/types": ["./types.ts"],
      "@wenathlan/getry/constants": ["./constants.ts"],
      "@wenathlan/getry/tests/researchfixtures": ["./tests/researchfixtures.ts"]
    }
  },
  "include": [
    "typeface.ts",
    "thinking.ts",
    "engine.ts",
    "llm.ts",
    "streaming.ts",
    "models.ts",
    "request.ts",
    "providers.ts",
    "antigravity.ts",
    "oauth.ts",
    "accounts.ts",
    "auth.ts",
    "server.ts",
    "cli.ts",
    "providercli.ts",
    "project.ts",
    "quota.ts",
    "recovery.ts",
    "fingerprint.ts",
    "search.ts",
    "utils.ts",
    "versionregistry.ts",
    "intelligence.ts",
    "json.ts",
    "jsonpolicy.ts",
    "jsonschema.ts",
        "gatewayprobe.ts",
    "gatewaysmoke.ts",
    "nodeshim.ts",
    "types.ts",
    "constants.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "tests", "Sol"]
}
