# the pulse text attributes.
# Normalize line endings to LF
* text=auto eol=lf

# git lfs carriers of the pulse repository: the voice-first studio binaries
# (the recorded audio masters, the rendered video takes, the waveform
# packages and the prepared archives) live in lfs so the automation lane
# can hash and catalog them without bloating the git objects.
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
