{
  "name": "@wenathlan/stealhead",
  "version": "2.0.58",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenathlan/devthink"
  },
  "description": "stealhead is the FPS game platform of the wenathlan family: it imports versawase from cadria and audio from debonair via the published library, with no engine file of its own — only game logics (match, ranking, weapons, world). The envelope distributes the documentation set and the tests directory as one package.",
  "keywords": [
    "stealhead",
    "fps",
    "game",
    "match",
    "ranking",
    "gameplay",
    "documentation"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "vite preview --host",
    "preview": "vite preview --host",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/client": "^7.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.23.1",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wouter": "^3.13.0"
  },
  "files": [
    "README.md",
    "docs",
    "tests"
  ],
  "homepage": "https://github.com/wenathlan/devthink/tree/main/stealhead",
