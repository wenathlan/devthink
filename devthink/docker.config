{
  "meta": {
    "name": "docker.config",
    "title": "devthink - the container configuration of the os (the compose pair, the nginx face, the runner engine)",
    "version": "2.0.173",
    "date": "2026-11-06",
    "language": "en",
    "sources": [
      "app:Dockerfile [the engine container — the runner heredoc, /healthz, EXPOSE 8080 7436]",
      "app:docker-compose.yml [the pair: devthink-engine + devthink-face, host 8085:8080, the engine direct lane 3215:8080 unpublished by default]",
      "app:nginx.conf [the vault pattern: resolver 127.0.0.11 valid=10s ipv6=off, location ^~ /api/, the _headers security law, the faun block, the root-emit seal]",
      "app:vite.config.ts [the root-emit outDir law — the hashed bundles land at the application root]",
      "app:package.json [the version stamp the compose args and this manifest carry]",
      "vault:nginx.conf [the reference pattern the family standardizes — the resolver law, the proxy lane, the header law]",
      "saddle:docker.config [the meta format this manifest follows — name, title, version, date, language, sources, mergeReport]",
      "app:Dockerfile [the container.mjs heredoc runner — the /healthz probe, DEVTHINK_HTTP_PORT 8080, the ram memory engine]"
    ],
    "mergeReport": {
      "rootFiles": [
        "Dockerfile",
        "docker-compose.yml",
        "nginx.conf",
        "docker.config"
      ],
      "composeServices": [
        "devthink-engine",
        "devthink-face"
      ],
      "portMap": {
        "face": "8085:8080",
        "engineDirect": "3215:8080 (unpublished by default — the face proxies the private compose network)"
      },
      "healthLane": "the image healthcheck (node fetch /healthz, body.ok===true)",
      "conflictResolution": "the vault nginx.conf pattern owns the conf law and the saddle docker.config meta format owns this manifest — one owner per law, the family consumes (the engineowners doctrine)",
      "pinPatch": "the family base nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 rides the runner and sandbox faces; the static faces ride the registry site image the publish lane stamps"
    }
  },
  "engine": {
    "service": "devthink-engine",
    "surface": "the devthink runner: node container.mjs on DEVTHINK_HTTP_PORT (8080), the /healthz probe the image healthcheck rides, the ram memory engine (no state volume)",
    "port": "8080",
    "healthcheck": "node fetch /healthz — body.ok===true (rides the image)",
    "stateHome": "ram (DEVTHINK_MEMORY_ENGINE=ram) — no volume",
    "entry": "the runner engine (node container.mjs, /healthz, port 8080)"
  },
  "face": {
    "service": "devthink-face",
    "image": "nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6",
    "surface": "the nginx face: the family base (nginx-unprivileged) with the family conf mounted (nginx.conf) and the staged static build mounted from the application root (the root-emit law — the operator runs the web build first)",
    "listen": 8080,
    "seals": [
      "the faun db block (403)",
      "the root-emit source seal (403)",
      "the dotfile seal (403)",
      "the tree seal (node_modules, tests, docs, sol — 403)"
    ],
    "spaRewrite": "try_files $uri $uri/ /index.html"
  },
  "apiLane": {
    "route": "/api/*",
    "upstream": "http://devthink-engine:8080",
    "resolver": "127.0.0.11 valid=10s ipv6=off (the docker embedded dns — request-time resolution, the vault law)",
    "body": "client_max_body_size 0 — the engine quota gate is the only ceiling",
    "timeouts": "read 300s / send 300s",
    "carries": "the runner (node container.mjs) serves the platform routes over /api/* on DEVTHINK_HTTP_PORT (8080) with the /healthz probe the image healthcheck rides; the memory engine stays ram (no state volume — the runner law)"
  },
  "ports": {
    "faceHost": 8085,
    "faceInternal": 8080,
    "engineInternal": 8080,
    "engineDirectCommented": 3215,
    "collisionLaw": "every family face owns one distinct host door (80 for vault, 8081-8090 for the ten siblings) — no two composes ever claim the same host port"
  }
}
