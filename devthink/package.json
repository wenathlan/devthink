  "scripts": {
    "antigravity": "bun --watch llm.ts",
    "apifreeze:sync": "node apifreeze.gate.ts sync",
    "build": "node build.ts",
    "build:binary": "bun run buildbinary.ts",
    "build:terminal": "node build.terminal.ts",
    "build:web": "vite build",
    "check": "bun run check:secrets && bun run test",
    "check:maintenance": "node maintain.ts check",
    "check:metadata": "node release.ts check",
    "check:secrets": "bun run checksecrets.ts",
    "check:web": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "dependency:updates": "node dependencyupdates.ts sync",
    "dev": "bun --watch run devthink.ts",
    "dev:web": "vite --host",
    "digests:check": "node imagedigests.ts check",
    "digests:sync": "node imagedigests.ts sync",
    "format": "biome format --write .",
    "formatcheck": "biome format .",
    "lint": "biome lint --diagnostic-level=error --max-diagnostics=3000 .",
    "lint:fix": "biome lint --write .",
    "lint:warn": "biome lint --max-diagnostics=3000 .",
    "notes:release": "node release.ts notes",
    "land:signed": "bun scripts.signedlanding.ts",
    "pack:check": "npm pack --dry-run",
    "package": "pnpm build && npm pack ./distpackage --dry-run",
    "permdiff:sync": "node permdiff.ts sync",
    "provider": "tsx devthink.ts provider",
    "records:sync": "node agentcert.ts sync && node costcert.ts sync && node doccheck.ts sync && node matrixverify.ts sync && node pentest.ts sync && node poolaudit.ts sync && node readiness.ts sync && node recipes.ts sync && node soak.ts sync && node sweep.ts sync && node telemetryfree.ts sync && node wcag.ts sync",
    "release": "bun run check && bun run build",
    "server": "tsx server.ts",
    "start": "bun run devthink.ts",
    "start:web": "vite preview --host",
    "sync:maintenance": "node maintain.ts sync",
    "sync:metadata": "node release.ts sync",
    "terminal": "node devthink.terminal.ts",
    "test": "vitest run",
    "test:runtime": "vitest run --exclude \"tests/{doccheck,matrixverify,package,readiness,releasenotes,publishingpipeline,librarymodes,nativebridge,sweep}.test.ts\"",
    "test:chromium": "node chromiumsmoke.ts",
    "test:node": "node --experimental-strip-types --test tests/core.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check:metadata && pnpm validate:runtime && pnpm check && pnpm build && pnpm validate:security && pnpm validate:agents && pnpm validate:workflow && pnpm validate:apifreeze && pnpm validate:docs && pnpm validate:candidate && node recipes.ts && pnpm test && node dist/cli.js manifest && node dist/cli.js help && node packageextension.ts",
    "validate:agents": "node agentcert.ts && node costcert.ts",
    "validate:apifreeze": "node apifreeze.gate.ts",
    "validate:candidate": "node sweep.ts && node poolaudit.ts && node matrixverify.ts && node telemetryfree.ts && node soak.ts && node wcag.ts",
    "validate:docs": "node doccheck.ts",
    "validate:runtime": "node runtimepolicy.ts",
    "validate:security": "node pentest.ts && node cspaudit.ts && node permdiff.ts",
    "validate:workflow": "node workflowcheck.ts && node npmgate.ts",
    "workflow:updates": "node workflowupdates.ts sync"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "bun@1.4.4"
}
