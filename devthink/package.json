{
  "name": "@wenathlan/devthink",
  "version": "2.0.172",
  "private": false,
  "description": "DevThink is the merged AI development workbench: the provider-owned gateway engine, the DevThink browser extension (the agent surface), the Antigravity engine and the workbench CLI — one product, one binary, one metadata.",
  "license": "GPL-3.0-only",
  "scripts": {
    "antigravity": "bun --watch llm.ts",
    "apifreeze:sync": "node apifreeze.ts sync",
    "build": "node build.ts",
    "build:binary": "bun run build.ts binary",
    "build:terminal": "node build.ts terminal",
    "build:web": "vite build",
    "check": "bun run check:secrets && bun run test",
    "check:maintenance": "node maintain.ts check",
    "check:metadata": "node release.ts check",
    "check:secrets": "bun security.ts checksecrets",
    "check:web": "tsc --noEmit",
    "db:generate": "prisma generate --schema schema.prisma",
    "db:push": "prisma db push --schema schema.prisma --url \"${DEVTHINK_DATABASE_URL:-${DATABASE_URL:-file:./devthink.db}}\"",
    "dependency:updates": "node ../foundry/dependencyupdates.ts sync",
    "dev": "bun --watch run devthink.ts",
    "dev:web": "vite --host",
    "digests:check": "node imagedigests.ts check",
    "digests:sync": "node imagedigests.ts sync",
    "format": "biome format --write .",
    "formatcheck": "biome format .",
    "lint": "biome lint --diagnostic-level=error --max-diagnostics=3000 .",
    "lint:fix": "biome lint --write .",
    "lint:warn": "biome lint --max-diagnostics=3000 .",
    "notes:release": "node release.ts notes",
    "land:signed": "bun scripts.ts signedlanding",
    "pack:check": "npm pack --dry-run",
    "package": "pnpm build && npm pack ./distpackage --dry-run",
    "permdiff:sync": "node permdiff.ts sync",
    "provider": "tsx devthink.ts provider",
    "records:sync": "node agentcert.ts sync && node costcert.ts sync && node doccheck.ts sync && node matrixverify.ts sync && node pentest.ts sync && node poolaudit.ts sync && node ../foundry/readiness.ts sync && node recipes.ts sync && node soak.ts sync && node sweep.ts sync && node telemetryfree.ts sync && node wcag.ts sync",
    "release": "bun run check && bun run build",
    "server": "tsx server.ts",
    "start": "bun run devthink.ts",
    "start:web": "vite preview --host",
    "sync:maintenance": "node maintain.ts sync",
    "sync:metadata": "node release.ts sync",
    "terminal": "bun run devthink.ts terminal",
    "test": "vitest run",
    "test:runtime": "vitest run --exclude \"test/{doccheck,matrixverify,package,readiness,releasenotes,publishingpipeline,librarymodes,nativebridge,sweep}.test.ts\"",
    "test:chromium": "node chromiumsmoke.ts",
    "test:node": "node --experimental-strip-types --test test/core.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check:metadata && pnpm validate:runtime && pnpm check && pnpm build && pnpm validate:security && pnpm validate:agents && pnpm validate:workflow && pnpm validate:apifreeze && pnpm validate:docs && pnpm validate:candidate && node recipes.ts && pnpm test && node build/cli.js manifest && node build/cli.js help && node packageextension.ts",
    "validate:agents": "node agentcert.ts && node costcert.ts",
    "validate:apifreeze": "node apifreeze.ts",
    "validate:candidate": "node sweep.ts && node poolaudit.ts && node matrixverify.ts && node telemetryfree.ts && node soak.ts && node wcag.ts",
    "validate:docs": "node doccheck.ts",
    "validate:runtime": "node runtime.ts",
    "validate:security": "node pentest.ts && node build/security.js cspaudit && node permdiff.ts",
    "validate:workflow": "node workflow.ts && node ../foundry/npmgate.ts",
    "workflow:updates": "node workflow.ts sync"
  },
