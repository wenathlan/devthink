  "scripts": {
    "antigravity": "bun --watch llm.ts",
    "apifreeze:sync": "node tests/apifreeze.mjs sync",
    "build": "node tests/build.mjs",
    "build:binary": "bun run build.ts",
    "build:web": "vite build",
    "check": "bun run check:secrets && bun run test",
    "check:maintenance": "node tests/maintain.mjs check",
    "check:metadata": "node tests/release.mjs check",
    "check:secrets": "bun run checksecrets.ts",
    "check:web": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "dependency:updates": "node tests/dependencyupdates.mjs sync",
    "dev": "bun --watch run devthink.ts",
    "dev:web": "vite --host",
    "digests:check": "node tests/imagedigests.mjs check",
    "digests:sync": "node tests/imagedigests.mjs sync",
    "format": "biome format --write .",
    "formatcheck": "biome format .",
    "lint": "biome lint --diagnostic-level=error --max-diagnostics=3000 .",
    "lint:fix": "biome lint --write .",
    "lint:warn": "biome lint --max-diagnostics=3000 .",
    "notes:release": "node tests/release.mjs notes",
    "pack:check": "npm pack --dry-run",
    "package": "pnpm build && npm pack ./distpackage --dry-run",
    "permdiff:sync": "node tests/permdiff.mjs sync",
    "provider": "tsx devthink.ts provider",
    "release": "bun run check && bun run build",
    "server": "tsx server.ts",
    "start": "bun run devthink.ts",
    "start:web": "vite preview --host",
    "sync:maintenance": "node tests/maintain.mjs sync",
    "sync:metadata": "node tests/release.mjs sync",
    "test": "vitest run",
    "test:chromium": "node tests/chromiumsmoke.mjs",
    "test:node": "node --experimental-strip-types --test tests/core.test.ts tests/provider/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm check:metadata && pnpm validate:runtime && pnpm check && pnpm build && pnpm validate:security && pnpm validate:agents && pnpm validate:workflow && pnpm validate:apifreeze && pnpm validate:docs && pnpm validate:candidate && node tests/recipes.mjs && pnpm test && node dist/cli.js manifest && node dist/cli.js help && node tests/packageextension.mjs",
    "validate:agents": "node tests/agentcert.mjs && node tests/costcert.mjs",
    "validate:apifreeze": "node tests/apifreeze.mjs",
    "validate:candidate": "node tests/sweep.mjs && node tests/poolaudit.mjs && node tests/matrixverify.mjs && node tests/telemetryfree.mjs && node tests/soak.mjs && node tests/wcag.mjs",
    "validate:docs": "node tests/doccheck.mjs",
    "validate:runtime": "node tests/runtimepolicy.mjs",
    "validate:security": "node tests/pentest.mjs && node tests/cspaudit.mjs && node tests/permdiff.mjs",
    "validate:workflow": "node tests/workflowcheck.mjs && node tests/npmgate.mjs",
    "workflow:updates": "node tests/workflowupdates.mjs sync"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "packageManager": "bun@1.4.3"
}
