{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node", "vite/client"],
    "paths": {
      "@wenathlan/cadria/transcodeengine": ["../cadria/transcodeengine.ts"],
      "z-ai-web-dev-sdk": [
        "./node_modules/z-ai-web-dev-sdk/dist/index.d.ts"
      ],
      /* the sqlite mirror bridge of the stream fold (wave/streamfold): the
       * folded fallback arm of the getry stream keyword file lands its key
       * failures on the ApiKeyRow rows of getry/db.ts (the sqlite mirror),
       * and db.ts reads the better-sqlite3 declarations through import()
       * type queries — the node resolution that walks up from the getry
       * folder never sees the devthink install, so the specifier resolves
       * onto this app's own @types seat the same way every bridge resolves
       * (the declaration file is the candidate of record: the mirror loads
       * the real driver through a computed vite-ignored import, never
       * through this resolution). */
      "better-sqlite3": [
        "./node_modules/@types/better-sqlite3/index.d.ts"
      ],
      "@/*": ["./Sol/*", "./*"],
      "@wenathlan/saddle": ["./saddlefaces.ts"],
      "@wenathlan/saddle/memory": ["./saddlefaces.ts"],
      "hono": ["./honoface.ts"],
      "hono/cors": ["./honocorsface.ts"],
      "@hono/node-server": ["./hononodeserverface.ts"],
      "@hono/node-server/serve-static": ["./honoservestaticface.ts"],
      /* the hono seat bridge of the ownership wave (the gateway transport
       * the getry seat owns imports the hono family, and the os lanes that
       * walk the moved graph never install the getry tree — the resolution
       * walks the devthink install the same way every bridge does). every
       * entry answers BOTH seats the pinned tsconfig lanes serve, through
       * the face modules the keys resolve onto: the tsc pass reads the
       * declaration types the faces pin (the type imports below carry the
       * declarations the packages ship), while the tsx subprocess lanes
       * (the cli and e2e runners that boot the moved sources) load the
       * real runtime entries the faces re-export through their relative
       * node_modules paths — the one resolution node's walk from the
       * moved sources never finds. the candidates are tsconfig-relative
       * FILES on purpose: the paths pass resolves a file candidate from
       * this tree the same way for every importer, while a directory
       * candidate answers no subprocess lane (and a declaration-only
       * candidate carries no runtime exports the way the first bridge
       * attempt learned). */
      "@wenathlan/saddle/security": ["../saddle/security.ts"],
      "@wenathlan/saddle/modalityregistry": ["../saddle/modalityregistry.ts"],
      "@wenathlan/saddle/workloadlaw": ["../saddle/workloadlaw.ts"],
      "@wenathlan/saddle/sandbox": ["../saddle/sandbox.ts"],
      "@wenathlan/getry/thinking": ["../getry/thinking.ts"],
      /* the queue self-bridge: the getry llm source (imported through the
       * family bridge graph) speaks the published queue specifier and the
       * typecheck resolves it to this app's own source. */
      "@wenathlan/devthink/queue": ["./queue.ts"],
      "@wenathlan/getry/engine": ["../getry/engine.ts"],
      "@wenathlan/getry/llm": ["../getry/llm.ts"],
      "@wenathlan/getry/streaming": ["../getry/streaming.ts"],
      "@wenathlan/getry/models": ["../getry/models.ts"],
      "@wenathlan/getry/request": ["../getry/request.ts"],
      "@wenathlan/getry/providers": ["../getry/providers.ts"],
      "@wenathlan/getry/antigravity": ["../getry/antigravity.ts"],
      "@wenathlan/getry/oauth": ["../getry/oauth.ts"],
      "@wenathlan/getry/accounts": ["../getry/accounts.ts"],
      "@wenathlan/getry/project": ["../getry/project.ts"],
      "@wenathlan/getry/quota": ["../getry/quota.ts"],
      "@wenathlan/getry/recovery": ["../getry/recovery.ts"],
      "@wenathlan/getry/fingerprint": ["../getry/fingerprint.ts"],
      "@wenathlan/getry/search": ["../getry/search.ts"],
      "@wenathlan/getry/utils": ["../getry/utils.ts"],
      "@wenathlan/getry/versionregistry": ["../getry/versionregistry.ts"],
      "@wenathlan/getry/intelligence": ["../getry/intelligence.ts"],
      "@wenathlan/getry/json": ["../getry/json.ts"],
      "@wenathlan/getry/jsonpolicy": ["../getry/jsonpolicy.ts"],
      "@wenathlan/getry/jsonschema": ["../getry/jsonschema.ts"],
      "@wenathlan/getry/gatewayconfig": ["../getry/gatewayconfig.ts"],
      "@wenathlan/getry/gatewayviewconfig": ["../getry/gatewayviewconfig.ts"],
      "@wenathlan/getry/gatewayprobe": ["../getry/gatewayprobe.ts"],
      "@wenathlan/getry/gatewaysmoke": ["../getry/gatewaysmoke.ts"],
      "@wenathlan/getry/nodeshim": ["../getry/nodeshim.ts"],
      "@wenathlan/getry/types": ["../getry/types.ts"],
      "@wenathlan/getry/constants": ["../getry/constants.ts"],
      "@wenathlan/getry/tests/researchfixtures": ["../getry/tests/researchfixtures.ts"],
      /* the getry owner faces of the gateway ownership wave
       * (wave/ownership.gateway), mirrored from vite.config.ts: the
       * embedded gateway surfaces the grand merge interned in server.ts
       * (the http transport server, the request auth family, the console
       * cli and the provider cli) move to the getry owner root one face
       * per step, and the consumers speak them through the published
       * library specifiers — the typecheck and every tsx subprocess the
       * suites spawn resolve each specifier to the monorepo source the
       * sibling app carries (the auth family landed with step 2; the
       * server, cli and providercli faces land with the steps that
       * follow, their targets answer the day they land). the installed
       * 2.0.154 envelope carries none of these export surfaces yet, so
       * the bridge is the resolution of record until the published
       * envelope catches up. */
      "@wenathlan/getry/server": ["../getry/server.ts"],
      "@wenathlan/getry/auth": ["../getry/auth.ts"],
      "@wenathlan/getry/cli": ["../getry/cli.ts"],
      "@wenathlan/getry/providercli": ["../getry/providercli.ts"],
      /* the devthink self bridges of the ownership wave
       * (wave/ownership.getry), mirrored from the getry side: the moved
       * gateway graph leans on the os-owned seams it grew beside (config,
       * constants, core, the http/memory/policy/security lane, storage and
       * the shared types surface) through the published library specifiers
       * ("@wenathlan/devthink/config" and siblings), and the app itself is
       * the package those specifiers name — no node_modules copy exists to
       * answer them — so every self specifier resolves to this app's own
       * source here. the entries retire when the published devthink
       * envelope carries the export surfaces the moved graph consumes. */
      "@wenathlan/devthink/config": ["./config.ts"],
      "@wenathlan/devthink/constants": ["./constants.ts"],
      "@wenathlan/devthink/core": ["./core.ts"],
      "@wenathlan/devthink/http": ["./http.ts"],
      "@wenathlan/devthink/memory": ["./memory.ts"],
      "@wenathlan/devthink/policy": ["./policy.ts"],
      "@wenathlan/devthink/security": ["./security.ts"],
      "@wenathlan/devthink/server": ["./server.ts"],
      /* the oslabels self bridge of the provider console move (the gateway
       * ownership wave, step 5): the moved console's barrel reads the
       * paired label catalog through the published os specifier, and this
       * program resolves it to this app's own source the same way the
       * other self specifiers above ride. */
      "@wenathlan/devthink/oslabels": ["./oslabels.ts"],
      "@wenathlan/devthink/storage": ["./storage.ts"],
      "@wenathlan/devthink/types": ["./types.ts"],
      "@wenathlan/vault/labelstore": ["../vault/labelstore.ts"]
    }
  },
  "include": ["*.ts", "tests/**/*.ts", "Sol/**/*.ts", "Sol/**/*.tsx"],
  "exclude": ["tests/code", "dist", "node_modules"]
}
