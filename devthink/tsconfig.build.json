{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./Sol/*", "./*"],
      "@wenathlan/saddle/modalityregistry": ["../saddle/modalityregistrytypes.ts"],
      "@wenathlan/saddle/sandbox": ["../saddle/sandbox.ts"],
      "@wenathlan/getry/thinking": ["../getry/thinkingtypes.ts"],
      "@wenathlan/devthink/server": ["./server.ts"]
    }
  },
  "include": [
    "thinkingtypes.ts",
    "index.ts",
    "types.ts",
    "policy.ts",
    "memory.ts",
    "protocol.ts",
    "progress.ts",
    "hardening.ts",
    "dashdone.ts",
    "version.ts",
    "runtime.ts",
    "cjs.ts",
    "neutral.ts",
    "umd.ts",
    "node.ts",
    "bun.ts",
    "deno.ts",
    "plan.ts",
    "flow.ts",
    "export.ts",
    "headless.ts",
    "cli.ts",
    "agent.ts",
    "auth.ts",
    "http.ts",
    "server.ts",
    "page.ts",
    "mcp.ts",
    "serve.ts",
    "tools.ts",
    "bridge.ts",
    "crossbrowser.ts",
    "pack.ts",
    "companion.ts",
    "server.ts"
  ]
}
