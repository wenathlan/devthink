{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "isolatedModules": true,
    "outDir": "build",
    "rootDir": ".",
    "paths": {
      "@wenathlan/argan/dns": ["../argan/dns.ts"],
      "@wenathlan/foundry/bundlescan": ["../foundry/bundlescan.ts"],
      "@wenathlan/foundry/readiness": ["../foundry/readiness.ts"],

      "z-ai-web-dev-sdk": [
        "./node_modules/z-ai-web-dev-sdk/dist/index.d.ts"
      ],
      "@/*": ["./sol/*", "./*"],
      "@wenathlan/saddle/sandbox": ["../saddle/sandbox.ts"],
      /* the family faces the dev config already bridges (the build parity
       * the gateladder wave owns): the bare saddle specifier, the memory
       * seam and the workload law resolve through the ambient faces the
       * dev tsconfig carries, so the declaration pass never falls through
       * to the registry copy the node_modules tree answers — and the
       * babel seat face rides beside them the same way (the yaml and
       * babel lanes of modalities import @babel/core through a guarded
       * dynamic import whose typing the face answers, never a registry
       * lookup the consumer tree may not carry). */
      "@wenathlan/saddle": ["./saddlefaces.ts"],
      "@wenathlan/saddle/memory": ["./saddlefaces.ts"],
      "@wenathlan/saddle/workloadlaw": ["./saddlefaces.ts"],
      "@babel/core": ["./babelcoreface.ts"],
      /* the modality registry of the ladder retirement (wave/engineregroup1):
       * the sandbox lane reads the saddle catalog through the published
       * specifier and the declaration pass resolves it through the family
       * bridge exactly like the sandbox sibling above (the saddle envelope
       * publishes the ./modalityregistry export; the ambient modalitytypes.ts
       * mirror retired with the bridge — the catalog has one owner, the
       * engine). */
      "@wenathlan/saddle/modalityregistry": ["./modalitytypes.ts"],
      /* the getry declaration face bridges of the ownership wave
       * (wave/ownership.getry): the gateway modules answer through the
       * published library specifiers ("@wenathlan/getry/llm" and siblings),
       * and the declaration pass resolves every specifier to the owner's
       * generated declaration face (getry/dist/types, the emit of
       * ../getry/tsconfig.types.json) so the owner source never enters
       * this program, the emit stays flat under the application rootDir
       * and the emitted declarations keep referencing the owner library
       * specifier — the same law the thinkingtypes.ts ambient carried for
       * the thinking ladder alone before the wave. the face regenerates
       * before every pass that reads it (build.ts and the library modes
       * suite) exactly the way the prisma client generates above the
       * declaration emit. */
      "@wenathlan/getry/engine": ["../getry/dist/types/getry/engine.d.ts"],
      /* the thinking face of the ladder retirement (wave/engineregroup1):
       * the os speaks the owner's ThinkingLevelName (os.ts imports the type
       * through the published specifier) and the ambient thinkingtypes.ts
       * mirror retired the day the owner face mapped — the declaration pass
       * resolves the specifier to the owner's generated face exactly like
       * every other @wenathlan/getry/* face above (the ambient declaration
       * the mirror carried retired with it; the rungs have one owner). */
      "@wenathlan/getry/thinking": ["../getry/dist/types/getry/thinking.d.ts"],
      "@wenathlan/getry/validate": ["../getry/dist/types/getry/validate.d.ts"],
      "@wenathlan/getry/llm": ["../getry/dist/types/getry/llm.d.ts"],
      "@wenathlan/getry/streaming": ["../getry/dist/types/getry/streaming.d.ts"],
      "@wenathlan/getry/models": ["../getry/dist/types/getry/models.d.ts"],
      "@wenathlan/getry/request": ["../getry/dist/types/getry/request.d.ts"],
      "@wenathlan/getry/providers": ["../getry/dist/types/getry/providers.d.ts"],
      "@wenathlan/getry/antigravity": ["../getry/dist/types/getry/antigravity.d.ts"],
      "@wenathlan/getry/oauth": ["../getry/dist/types/getry/oauth.d.ts"],
      "@wenathlan/getry/accounts": ["../getry/dist/types/getry/accounts.d.ts"],
      "@wenathlan/getry/project": ["../getry/dist/types/getry/project.d.ts"],
      "@wenathlan/getry/quota": ["../getry/dist/types/getry/quota.d.ts"],
      "@wenathlan/getry/recovery": ["../getry/dist/types/getry/recovery.d.ts"],
      "@wenathlan/getry/fingerprint": ["../getry/dist/types/getry/fingerprint.d.ts"],
      "@wenathlan/getry/search": ["../getry/dist/types/getry/search.d.ts"],
      "@wenathlan/getry/utils": ["../getry/dist/types/getry/utils.d.ts"],
      "@wenathlan/getry/versionregistry": ["../getry/dist/types/getry/versionregistry.d.ts"],
      "@wenathlan/getry/intelligence": ["../getry/dist/types/getry/intelligence.d.ts"],
      "@wenathlan/getry/json": ["../getry/dist/types/getry/json.d.ts"],
      "@wenathlan/getry/jsonpolicy": ["../getry/dist/types/getry/jsonpolicy.d.ts"],
      "@wenathlan/getry/jsonschema": ["../getry/dist/types/getry/jsonschema.d.ts"],
      "@wenathlan/getry/gatewayconfig": ["../getry/dist/types/getry/gateway.d.ts"],
      "@wenathlan/getry/gatewayviewconfig": ["../getry/dist/types/getry/gateway.d.ts"],
      "@wenathlan/getry/gatewaycheck": ["../getry/dist/types/getry/gatewaycheck.d.ts"],
      "@wenathlan/getry/nodeshim": ["../getry/dist/types/getry/nodeshim.d.ts"],
      "@wenathlan/getry/types": ["../getry/dist/types/getry/types.d.ts"],
      "@wenathlan/getry/constants": ["../getry/dist/types/getry/constants.d.ts"],
      /* the getry owner faces of the gateway ownership wave
       * (wave/ownership.gateway): the embedded gateway surfaces the grand
       * merge interned in server.ts (the http transport server, the
       * request auth family, the console cli and the provider cli) move
       * to the getry owner root one face per step, and the declaration
       * pass resolves every specifier to the owner's generated
       * declaration face (getry/dist/types, the emit of
       * ../getry/tsconfig.types.json) the same way the engine family
       * rides it — the owner source never enters this program, the emit
       * stays flat and the emitted declarations keep referencing the
       * owner library specifier (the auth family landed with step 2; the
       * server, cli and providercli faces land with the steps that
       * follow, their faces answer the day they land). */
      "@wenathlan/getry/server": ["../getry/dist/types/getry/server.d.ts"],
      "@wenathlan/getry/auth": ["../getry/dist/types/getry/auth.d.ts"],
      "@wenathlan/getry/cli": ["../getry/dist/types/getry/cli.d.ts"],
      "@wenathlan/getry/providercli": ["../getry/dist/types/getry/providercli.d.ts"],
      /* the devthink self bridges of the ownership wave
       * (wave/ownership.getry), mirrored from tsconfig.json: the moved
       * gateway graph leans on the os-owned seams through the published
       * library specifiers, and the declaration pass resolves every self
       * specifier to this app's own source. */
      "@wenathlan/devthink/config": ["./config.ts"],
      "@wenathlan/devthink/constants": ["./constants.ts"],
      "@wenathlan/devthink/core": ["./core.ts"],
      "@wenathlan/devthink/http": ["./http.ts"],
      "@wenathlan/devthink/memory": ["./memory.ts"],
      "@wenathlan/devthink/policy": ["./policy.ts"],
      "@wenathlan/devthink/security": ["./security.ts"],
      "@wenathlan/devthink/server": ["./server.ts"],
      /* the oslabels self bridge of the provider console move (the gateway
       * ownership wave, step 5): the moved console's barrel reads the
       * paired label catalog through the published os specifier, and the
       * declaration pass resolves it to this app's own source the same way
       * the other self specifiers above ride. */
      "@wenathlan/devthink/oslabels": ["./os.ts"],
      "@wenathlan/devthink/storage": ["./storage.ts"],
      "@wenathlan/devthink/types": ["./types.ts"]
    }
  },
  "include": [
    "index.ts",
    "types.ts",
    /* the os seam entries of the ownership wave (wave/ownership.getry): the
       exports map answers the published specifiers the moved gateway graph
       imports (config, constants, core, data, storage, security beside the
       tools and types surfaces already carried), so the declaration emit
       covers every entry the flat package stages. */
    "config.ts",
    "constants.ts",
    "core.ts",
    "data.ts",
    /* the oslabels seam entry of the provider console move (the gateway
       ownership wave, step 5): the moved console's barrel reads the paired
       label catalog through the published os specifier, so the declaration
       emit covers the seam the same way the os seam entries above ride. */
    "os.ts",
    "graph.ts",
    "hono.ts",
    "commands.ts",
    "engines.ts",
    "storage.ts",
    "security.ts",
    "policy.ts",
    "memory.ts",
    "protocol.ts",
    "progress.ts",
    "hardening.ts",
    "dashboard.ts",
    "queue.ts",
    /* the doors the family law charges: the theme seat and the reveal
       door ship their declarations the same flat-package grammar every
       module entry rides. */
    "personalstore.ts",
    "reveal.ts",
    "version.ts",
    "runtime.ts",
    "cjs.ts",
    "neutral.ts",
    "umd.ts",
    "node.ts",
    "bun.ts",
    "deno.ts",
    "plan.ts",
    "flow.ts",
    "export.ts",
    "headless.ts",
    "cli.ts",
    "agent.ts",
    "auth.ts",
    "http.ts",
    "server.ts",
    "page.ts",
    "mcp.ts",
    "serve.ts",
    "tools.ts",
    "bridge.ts",
    "crossbrowser.ts",
    "pack.ts",
    "companion.ts",
    /* the personalstore seam entry (the tsroot law's family door): the
       exports map answers the published ./personalstore specifier the
       stealthhead theme door reads, so the declaration emit covers the
       entry the flat package stages. */
    "personalstore.ts",
    "server.ts"
  ]
}
