// devthink os prisma schema for prisma 7 with driver adapter
// datasource url provided by the prisma config and adapter in database.ts
// model names pascalcase so prisma generates camelcase accessors
// lives at the application root: the prisma resolver reads schema.prisma
// first (the prisma folder and the Sol folder stay as honored candidates)
//
// family sync contract: a table of the same kind carries the same columns
// and the same pointers in every application that holds the kind — identity
// pointers are text, counts are 32-bit ints, time is datetime or iso text,
// and byte-scale pointers (sizes, lengths, offsets) are 64-bit BigInt, the
// pointer that holds terabytes. The sqlite autoincrement rowid is 64-bit by
// the engine contract. The family schemas mirror this contract; a kind born
// here propagates.
//
// wave/ownership.getry: the gateway kinds (ChatMessage, NvidiaKey, TownKey,
// ApiKey) moved to getry/schema.prisma — the gateway owns its own sqlite
// datasource beside the engine that writes it. this schema keeps the os
// kinds (OnboardingState, CopyRow, PlanState) AND mirrors the gateway kinds
// the os storage lane still persists (the engine seam writes ChatMessage
// through devthink/storage.ts and the key resolution reads the key tables
// through the same lazy client — one client serves the lane), per the
// family sync contract: the mirrored tables carry the same columns and the
// same pointers getry/schema.prisma declares. the mirror retires the day
// the storage lane's gateway persistence answers from the getry owner.

generator client {
  provider = "prisma-client-js"
  /* no explicit output: the client generates into the node_modules/.prisma
     folder of the nearest package root, exactly where the @prisma/client
     the application imports resolves it (an explicit relative output
     generates beside the schema's parent and the runtime stub never
     finds it). */
}

datasource db {
  provider = "sqlite"
}

/// the catalogued visitor state of the entry flow: one row per visitor
/// carrying the seen flags of the opening (intro) and the frame-a-frame
/// onboarding tour — the flags the /api/v1/onboarding route serves
model OnboardingState {
  id             Int      @id @default(autoincrement())
  visitor        String   @unique
  introseen      Boolean  @default(false)
  onboardingseen Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@index([onboardingseen])
}

/// the copy table: every user-visible string the components render, one
/// row per dotted key — the components are stubs loading by id through
/// /api/v1/copy, the build seed ingests here and the db is the living
/// config of the copy (the build never ships the table itself)
model CopyRow {
  key       String   @id
  text      String
  updatedAt DateTime @updatedAt
}

/// the visual gate of the os: the plan the visitor selected (the engines
/// carry no limits — this row only stamps the badge the identity wears
/// and the enterprise custom megabytes the person defined)
model PlanState {
  id        Int      @id @default(autoincrement())
  visitor   String   @unique
  tier      String   @default("free")
  storagemb BigInt?
  rammib    BigInt?
  since     DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier])
}

// ---------------------------------------------------------------------------
// the gateway-kind mirrors of the ownership wave (wave/ownership.getry): the
// columns and the pointers copy getry/schema.prisma verbatim per the family
// sync contract — the master surface lives at the gateway owner; these
// tables exist only because the os storage lane still persists the engine
// seam's ChatMessage rows and the db keysource still reads the key tables
// through this app's own lazy client (one client serves the lane). the
// mirror retires the day the storage lane's gateway persistence answers
// from the getry owner.
// ---------------------------------------------------------------------------

/// every interaction log across v1 zai v2 babel v3 nvidia v4 opencode kilo v5 openrouter (mirror of the getry master)
model ChatMessage {
  id                  String  @id @default(cuid())
  active              Boolean @default(true)
  allparams           String?
  allresponse         String?
  annotations         String?
  autofixapplied      String?
  cachedtokens        Int     @default(0)
  chattemplatekwargs  String?
  completedat         DateTime?
  completion          String?
  completiontokens    Int?
  content             String  @default("")
  contextshared       Boolean @default(false)
  devthinkcontext     Int?
  devthinkoutput      Int?
  endpoint            String?
  error               String?
  errorcode           String?
  errormessage        String?
  finishreason        String?
  firsttokenms        Int     @default(0)
  frequencypenalty    Float?
  httpstatus          Int?
  inputtokens         Int     @default(0)
  ip                  String  @default("unknown")
  ipused              String  @default("unknown")
  keyid               String?
  keylabel            String?
  latencyms           Int     @default(0)
  lastused            DateTime?
  logprobs            String?
  maxtokens           Int?
  messagenumber       Int?
  model               String?
  modelvariant        String?
  objectid            String?
  outputtokens        Int     @default(0)
  presencepenalty     Float?
  prompttokens        Int     @default(0)
  provider            String?
  reasoningcontent    String?
  reasoningeffort     String?
  reasoninglevel      String?
  requestid           String?
  responseid          String?
  responseheaders     String?
  retries             Int     @default(0)
  role                String  @default("assistant")
  rotationcount       Int     @default(0)
  rotationindex       Int?
  route               String?
  seed                Int?
  servicetier         String?
  sessionid           String?
  sources             String?
  startedat           DateTime?
  status              String  @default("active")
  stop                String?
  stopsequence        String?
  stream              Boolean @default(false)
  streammode          Boolean @default(false)
  version             String?
  twocalls            Boolean?
  systemfingerprint   String?
  temperature         Float?
  thinking            String?
  thinkingbudget      Int?
  thinkingenabled     Boolean @default(true)
  thinkinglevel       String?
  thinkingtokens      Int     @default(0)
  toolcalls           String?
  topk                Int?
  topp                Float?
  totaltokens         Int     @default(0)
  useragent           String?
  useragentforged     String?
  createdat           DateTime @default(now())
  updatedat           DateTime @updatedAt

  @@index([sessionid])
  @@index([route])
  @@index([model])
  @@index([provider])
  @@index([status])
  @@index([createdat])
}

/// nvidia api key management with rotation (mirror of the getry master)
model NvidiaKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  rateLimitRemaining Int?
  rateLimitResetAt  DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([active])
  @@index([status])
}

/// babel town key management (mirror of the getry master)
model TownKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([active])
  @@index([status])
}

/// api key management for other providers (mirror of the getry master)
model ApiKey {
  id              String   @id @default(cuid())
  keyValue        String   @unique
  provider        String
  label           String?
  active          Boolean  @default(true)
  status          String   @default("active")
  lastUsedAt      DateTime?
  errorCount      Int      @default(0)
  successCount    Int      @default(0)
  lastError       String?
  lastErrorAt     DateTime?
  latencyP50      Int?
  latencyP95      Int?
  latencyP99      Int?
  createdat       DateTime @default(now())
  updatedat       DateTime @updatedAt

  @@index([provider])
  @@index([active])
  @@index([status])
}

