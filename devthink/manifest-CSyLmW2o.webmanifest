{
  "name": "DevThink — AI Development Workbench",
  "short_name": "DevThink",
  "description": "Browser-like workbench for embedded gateway sessions and normalized AI streams.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#17191f",
  "theme_color": "#17191f",
  "orientation": "any",
  "scope": "/",
  "lang": "pt-BR",
  "dir": "ltr",
  "categories": ["productivity", "developer", "utilities"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Console",
      "short_name": "Console",
      "description": "Open the workbench console",
      "url": "/console",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Gateway",
      "short_name": "Gateway",
      "description": "Open the gateway sessions view",
      "url": "/gateway",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Open the workbench settings",
      "url": "/settings",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
