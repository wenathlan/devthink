# DevThink application build artifacts (the workspace anchor at the repository
# root carries the repository-wide contract; this file scopes the application
# tree the biome vcs integration reads).
node_modules
dist
distpackage
releasecheck
build
release
Sol/dist
Sol/node_modules
Sol/.vite
*.db
*.db-journal
.env
.env.local
*.log
coverage

# the generated capacitor shells of the mobile lane (runner-side toolchain output, never committed)
android/
ios/
capacitor.config.json
# the probe browser profiles and the probe output dirs stay out of the tree
tests/artifacts/*/profile/
tests/artifacts/trylle-root/
tests/artifacts/trylle-set/
tests/artifacts/trylle-set2/
tests/artifacts/chat-optin-probe/
tests/artifacts/desktop-probe/
tests/artifacts/chat-probe/
tests/artifacts/routeprobe/
