/* sol.css.shelldelta — the named classes born in the task 1-b shell
   eradication wave (the tailwind exit of Sol/panel/windowframe.tsx and the
   menu marks of Sol/panel/desktopmenu.tsx). One file, one namespace block
   per consumer: .dsk-menu-* rides the desktop context menus, .shell-window*
   rides the floating window chrome, .snap-flyout*/.snap-ghost ride the snap
   layouts. Every rule speaks pure hand css over the --color-* token ladder
   of the @theme foundation — zero utilities, zero raw #000/#fff fills,
   backdrop-filter always paired with -webkit-, state colors switch
   instantly, motion only on transform/opacity/background washes. The fold
   collapses this file into Sol/sol.css and drops the one-line shim
   (Sol/shelldelta.css). */

/* ---------------------------------------------------------------- */
/* desktopmenu — the radio mark and the submenu caret               */
/* ---------------------------------------------------------------- */

/* the checked radio of the View submenu: the accent glyph at the shortcut
   slot (the plain "●" text died with the glyph purge) */
.dsk-menu__radio {
  display: inline-flex;
  flex: none;
  align-items: center;
  margin-left: auto;
  color: var(--color-win);
}

/* the submenu caret: chevron rotating 90deg on open (i4), the "▸" text died */
.dsk-menu__caret {
  display: inline-flex;
  flex: none;
  align-items: center;
  margin-left: auto;
  color: var(--color-ink-3);
  transition: transform 150ms var(--ease-micro);
}
.dsk-menu__caret[data-open="true"] { transform: rotate(90deg); }

/* ---------------------------------------------------------------- */
/* windowframe — the floating window chrome                         */
/* ---------------------------------------------------------------- */

/* the frame: layout stays on the element, the paint (border, wash, shadow,
   outline, blur, entrance animation) lives here. Inactive is the base pose;
   .is-active lifts border, wash, shadow and the signal outline. State
   colors switch instantly (no shadow/outline transition — e18). */
.shell-window {
  position: absolute;
  display: flex;
  flex-direction: column;
  min-width: 320px;
  min-height: 300px;
  overflow: hidden;
  border: 1px solid rgb(255 255 255 / 8%);
  border-radius: var(--radius-md);
  background: linear-gradient(180deg, rgb(27 30 39 / 78%), rgb(18 20 26 / 90%));
  box-shadow: 0 8px 24px rgb(0 0 0 / 35%);
  outline: 1px solid rgb(255 255 255 / 5%);
  outline-offset: 0;
  -webkit-backdrop-filter: blur(26px) saturate(130%);
  backdrop-filter: blur(26px) saturate(130%);
  animation: var(--animate-window-in);
}
.shell-window.is-active {
  border-color: rgb(255 255 255 / 14%);
  background:
    radial-gradient(120% 42% at 50% -12%, rgb(231 233 238 / 5%) 0%, transparent 62%),
    linear-gradient(180deg, rgb(28 32 42 / 88%), rgb(20 22 29 / 94%));
  box-shadow:
    0 16px 48px rgb(0 0 0 / 55%),
    inset 0 1px 0 rgb(255 255 255 / 6%);
  outline-color: color-mix(in srgb, var(--color-signal) 45%, transparent);
}
[data-theme="light"] .shell-window { border-color: rgb(0 0 0 / 12%); }

/* the state poses the tailwind data-variants used to carry */
.shell-window[data-flying] { pointer-events: none; }
.shell-window[data-min="true"] { display: none; }
.shell-window[data-closing="true"] { pointer-events: none; animation: var(--animate-window-out); }
.shell-window[data-state="maximized"] {
  inset: 0;
  width: 100%;
  height: 100%;
  border-width: 0;
  border-radius: 0;
  outline-width: 0;
}
.shell-window[data-state="snapped-left"] {
  top: 0;
  left: 0;
  width: 50%;
  height: 100%;
  border-radius: 0;
  outline-width: 0;
}
.shell-window[data-state="snapped-right"] {
  top: 0;
  right: 0;
  left: auto;
  width: 50%;
  height: 100%;
  border-radius: 0;
  outline-width: 0;
}
@media (max-width: 859px) {
  .shell-window { min-width: 0; min-height: 0; }
  .shell-window[data-state="snapped-left"],
  .shell-window[data-state="snapped-right"] { width: 100%; }
}
@media (prefers-reduced-transparency: reduce) {
  .shell-window { background: var(--dt-panel); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .shell-window__bar { -webkit-backdrop-filter: none; backdrop-filter: none; }
}

/* the titlebar: 30px acrylic (owner law 28-30px), hairline bottom, the
   inactive window grayscales instantly (no filter transition — e18) */
.shell-window__bar {
  display: flex;
  flex: none;
  min-height: 30px;
  align-items: stretch;
  padding-left: 14px;
  border-bottom: 1px solid rgb(255 255 255 / 7%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  backdrop-filter: blur(20px) saturate(140%);
  user-select: none;
  touch-action: none;
}
[data-theme="light"] .shell-window__bar {
  border-bottom-color: rgb(0 0 0 / 10%);
  background: rgb(0 0 0 / 3%);
}
.shell-window:not(.is-active) .shell-window__bar { filter: grayscale(0.8); }

/* the ONE lockup of the window zone: mark, name, role line */
.shell-window__lockup {
  display: inline-flex;
  min-width: 0;
  flex: none;
  align-items: center;
  align-self: center;
  gap: 9px;
  padding-right: 12px;
}
.shell-window__mark {
  display: grid;
  place-items: center;
  color: rgb(255 255 255);
  pointer-events: none;
}
.shell-window:not(.is-active) .shell-window__mark { color: rgb(243 245 250); }
.shell-window__app {
  color: var(--color-ink);
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
}
/* the role line: spacing separates it from the name — the middot pseudo
   died with the separator purge (e10) */
.shell-window__role {
  max-width: 30ch;
  overflow: hidden;
  color: var(--color-ink-2);
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0.06em;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-transform: lowercase;
}
.shell-window:not(.is-active) .shell-window__role { color: var(--color-ink-3); }

/* the session tab strip riding beside the lockup */
.shell-window__tabs {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: flex-end;
  padding-left: 2px;
}

/* the caption controls: the snap pair inside the bar, the fluent 46px
   min/max pair and the close button on the classic red tokens */
.shell-window__controls {
  display: flex;
  align-items: stretch;
  margin-left: auto;
}
.shell-window__snap {
  display: inline-flex;
  align-items: stretch;
  margin-right: 6px;
}
.shell-window__snapbtn {
  display: grid;
  width: 38px;
  height: 26px;
  place-items: center;
  align-self: center;
  border: 0;
  border-radius: var(--radius-xs);
  background: transparent;
  color: var(--color-ink-3);
  cursor: pointer;
  transition:
    background-color 200ms var(--ease-micro),
    transform 100ms var(--ease-micro);
}
.shell-window__snapbtn:hover {
  background: rgb(255 255 255 / 10%);
  color: var(--color-ink);
}
.shell-window__snapbtn:active { transform: scale(0.7); }
.shell-window__caption,
.shell-window__close {
  display: grid;
  width: 46px;
  place-items: center;
  align-self: stretch;
  border: 0;
  border-left: 1px solid rgb(255 255 255 / 5%);
  border-radius: var(--radius-xs);
  background: transparent;
  color: var(--color-ink-2);
  cursor: pointer;
  transition:
    background-color 100ms var(--ease-micro),
    color 100ms var(--ease-micro);
}
.shell-window__caption:hover {
  background: rgb(255 255 255 / 8%);
  color: var(--color-ink);
}
.shell-window__caption:active {
  background: rgb(255 255 255 / 12%);
  color: var(--color-ink);
}
.shell-window__close:hover {
  background: var(--color-close);
  color: rgb(255 255 255);
}
.shell-window__close:active {
  background: var(--color-close-deep);
  color: rgb(255 255 255);
}
.shell-window__snapbtn:focus-visible,
.shell-window__caption:focus-visible,
.shell-window__close:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}

/* the body rows: tab strip, context, canvas, rail, footer */
.shell-window__body {
  display: grid;
  min-height: 0;
  flex: 1;
  grid-template-rows: auto auto minmax(0, 1fr) auto auto;
}

/* the os.js resize strips: 8px edges inset 14px (the rounded clipping
   survives) and the 14px corner grips, one rule per direction */
.shell-window__rz { position: absolute; z-index: 3; touch-action: none; }
.shell-window__rz[data-direction="n"] { top: 0; right: 14px; left: 14px; height: 8px; cursor: ns-resize; }
.shell-window__rz[data-direction="s"] { right: 14px; bottom: 0; left: 14px; height: 8px; cursor: ns-resize; }
.shell-window__rz[data-direction="e"] { top: 14px; right: 0; bottom: 14px; width: 8px; cursor: ew-resize; }
.shell-window__rz[data-direction="w"] { top: 14px; bottom: 14px; left: 0; width: 8px; cursor: ew-resize; }
.shell-window__rz[data-direction="ne"] { top: 0; right: 0; width: 14px; height: 14px; cursor: nesw-resize; }
.shell-window__rz[data-direction="nw"] { top: 0; left: 0; width: 14px; height: 14px; cursor: nwse-resize; }
.shell-window__rz[data-direction="se"] { right: 0; bottom: 0; width: 14px; height: 14px; cursor: nwse-resize; }
.shell-window__rz[data-direction="sw"] { bottom: 0; left: 0; width: 14px; height: 14px; cursor: nesw-resize; }

/* ---------------------------------------------------------------- */
/* snap layouts — the flyout, its templates and the aero ghost      */
/* ---------------------------------------------------------------- */

/* the flyout panel: the acrylic surface rides the design-system class, the
   geometry and the entrance live here */
.snap-flyout {
  display: grid;
  min-width: 260px;
  gap: 8px;
  padding: 10px;
  border-radius: var(--radius-md);
  transform-origin: top;
  animation: var(--animate-flyout-in);
}
.snap-flyout__layout {
  display: grid;
  border: 1px solid rgb(255 255 255 / 6%);
  border-radius: var(--radius-xs);
  background: rgb(255 255 255 / 4%);
  transition:
    background-color 150ms var(--ease-micro),
    border-color 150ms var(--ease-micro);
}
.snap-flyout__layout:hover { background: rgb(255 255 255 / 8%); }
.snap-flyout__layout[data-active="true"] {
  border-color: rgb(231 233 238 / 45%);
  background: var(--signal-wash);
}
.snap-flyout__cell {
  min-height: 0;
  min-width: 0;
  padding: 0;
  border: 0;
  border-radius: 2px;
  background: rgb(255 255 255 / 13%);
  cursor: pointer;
  transition: background-color 100ms var(--ease-micro);
}
.snap-flyout__cell:hover { background: rgb(255 255 255 / 22%); }
.snap-flyout__cell:focus-visible {
  outline: 2px solid rgb(255 255 255 / 70%);
  outline-offset: 1px;
}
.snap-flyout__cell[data-active="true"] {
  background: rgb(231 233 238 / 30%);
  outline: 1px solid rgb(231 233 238 / 80%);
  outline-offset: 0;
}

/* the aero edge ghost: the half the drag would snap into */
.snap-ghost {
  position: fixed;
  border: 1px solid rgb(231 233 238 / 80%);
  border-radius: var(--radius-md);
  background: rgb(231 233 238 / 15%);
  pointer-events: none;
}
