# Node version restriction is advisory (engine-strict=false): the CI
# typecheck matrix legitimately probes the Node 24.x LTS line while the
# engines field documents the production runtime floor (26.7.0), and the
# npm bundled with Node 26.7.0 on the runners is 11.19.0, below the
# historical >=12.0.2 note. Same policy as the Saddle pipeline.
engine-strict=false
cache-integrity=true
prefer-online=true
fetch-retries=5
save-exact=false
save-prefix=^
prefer-dedupe=true
fund=false
audit=true
loglevel=warn

# the sqlite lottery dies here: npm ci in the pages and family lanes answers this file and skips every package lifecycle script (the better-sqlite3 gyp rebuild rides a mirror lottery no lane ever depended on — no built surface imports the native binding); explicit commands like npm run web:build:pages still run their script
ignore-scripts=true
