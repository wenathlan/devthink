// the saddle typescript baseline (the web theme compilerOptions over the
// engine sources: one project covers the app root and the Sol theme).
// strict stays off and noCheck rides with it: the grand-merge engine
// sources carry the loose typing baseline the upstream saddle authored
// them under (strict: false with noCheck: true there), so the tsc gate
// stays a parse gate while the deterministic contract answers through
// the node --check pass and the test suite.
{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "strict": false,
    "noCheck": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./Sol/*", "./*"],
      "@saddle/isolation": ["./isolation.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "Sol/**/*.ts", "Sol/**/*.tsx", "docs/example-*.ts", "jsdom.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "coverage", "web", "tests", "build"]
}
