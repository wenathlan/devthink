// the saddle typescript baseline (the source-is-library law the vault
// doctrine brought to the family: the .ts sources ARE the engine — node 26
// strips the types, the explicit .ts imports resolve natively, the browser
// lanes bundle through vite and nothing ever emits a dist tree).
// the grand-merge engine sources keep the loose typing baseline the
// upstream saddle authored them under (strict: false, noCheck: true), with
// the theme options (jsx, the vite client types) riding beside them so the
// one project keeps covering the Sol surface.
{
  "compilerOptions": {
    "target": "ES2024",
    "noEmit": true,
    "module": "NodeNext",
    "strict": false,
    "noCheck": true,
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./sol/*", "./*"],
      "@saddle/isolation": ["./isolation.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "sol/**/*.ts", "sol/**/*.tsx", "docs/example-*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "coverage", "web", "tests", "build"]
}
