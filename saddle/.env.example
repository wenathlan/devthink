# saddle sandbox environment variables
# copy to .env and fill in your values

# database url — the same sqlite file the prisma schema, init.sql and
# web.server.ts share (the schema datasource reads env("SADDLE_DB"))
SADDLE_DB="file:./saddle.db"
# sandbox storage quota in bytes (optional; the scheduler enforces it)
# SADDLE_SANDBOX_QUOTA_BYTES=""
