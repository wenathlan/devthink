  "scripts": {
    "build:engine": "node scriptsbuildengine.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "formatcheck": "node --import tsx format.ts",
    "test": "vitest run",
    "run": "npm run build:engine && node --import tsx ./cli.ts",
    "release:assets": "npm run build:engine && node --import tsx ./distribution.ts",
    "release:verify": "npm run build:engine && node --import tsx ./distribution.ts verify",
    "target:manifest": "npm run build:engine && node --import tsx ./distribution.ts target",
    "pack:check": "npm run check && npm run formatcheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run pack:check",
    "tauri": "npx --yes @tauri-apps/cli@2.11.4",
    "capacitor:sync:android": "npm run web:build:pages && cap sync android",
    "capacitor:sync:ios": "npm run web:build:pages && cap sync ios",
    "native:check:flat": "node scriptsvalidateflatnative.ts",
    "web:dev": "vite --host",
    "web:check": "npm run build:engine && tsc --project tsconfig.json --noEmit",
    "web:build": "vite build",
    "web:build:pages": "vite build",
    "web:preview": "vite preview --host",
    "build": "npm run build:engine",
    "build:tsc": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx ./cli.ts plan",
    "dev": "node --import tsx --watch ./cli.ts",
    "web": "node webserver.ts",
    "qemu:bridge": "node ./orchestrator.ts --qemu-bridge",
    "toolchain:verify": "node --version && npx tsc --version && python3 --version && qemu-system-x86_64 --version || true && docker --version",
    "dev:tsx": "node --import tsx --watch ./cli.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "biome lint .",
    "lint:biome": "biome lint --write .",
    "lint:fix": "biome lint --write . && biome check --write .",
    "format": "biome format --write .",
    "format:biome": "biome format --write .",
    "format:check": "biome check .",
    "test:watch": "node --test --watch \"tests/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.ts\"",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "test:e2e": "node --test \"tests/*.test.ts\"",
    "qemu:version": "qemu-system-x86_64 --version || echo 'qemu 11.1.0 expected 2026-08-22'",
    "vm:create": "node --import tsx ./cli.ts vm",
    "vm:validate": "node --import tsx ./cli.ts vmlint",
    "gpu:list": "node --import tsx ./cli.ts gpus",
    "docker:build": "docker build -f Dockerfile -t saddle:2.0.166 ..",
    "docker:run": "docker run --rm --memory-swap=-1 --shm-size=2g saddle:2.0.166",
    "docker:health": "docker run --rm -d --name saddle-health -p 8080:8080 saddle:2.0.166 >/dev/null && sleep 5; curl -fsS http://localhost:8080/api/v1/health || true; docker rm -f saddle-health >/dev/null 2>&1 || true",
    "firecracker:boot": "firecracker --api-sock /tmp/fc-saddle.sock --config-file vmconfig.json 2>/dev/null || echo 'firecracker 1.16.1 warm-pool boot 125ms target'",
    "py:bridge": "python3 qemubridge.py",
    "py:test": "python3 -m pytest -q || python3 qemubridge.py",
    "clean": "rm -rf distpackage coverage .biome __pycache__",
    "prepare": "echo 'saddle grand-merge toolchain 2026-08-23: Node 26.12.0 Current / 24.19.0 LTS, npm 12.0.2, TS 7.0.2, Python 3.14.7, Docker 29.7.2, QEMU 11.1.0, Mesa 26.2.1, LLVM 22.1.8, Firecracker 1.16.1'",
    "start:engine": "node --import tsx ./cli.ts plan"
