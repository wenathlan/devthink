# the strict content security policy of the static face (the csp family
# law of the wave/csp-ratelaw, the checklist mandate 1222): the same
# directive shape rides every app root of the family and the sources
# read their evidence off this face. script-src stays 'self' alone — the
# external module script of index.html is the only script tag the face
# carries, no inline boot script rides this app, so no hash, no
# unsafe-inline and no eval ever enters the script lane. style-src
# carries 'unsafe-inline' for styles only, because the react face
# composes its inline style attributes (a style never executes, the
# script lane stays sealed). img-src adds data: for the svg noise
# backgrounds of sol.css. media-src, font-src and frame-src stay 'self'.
# connect-src stays 'self' — the /api lanes ride this origin (the mesh
# node probe of the dashboard degrades to its unreachable row when the
# no-cors lane stays sealed, the signed /api/v1/mesh/ping lane keeps
# answering), and a build that declares a remote engine or onboarding
# base under the vite env law widens connect-src with that origin at
# deploy. frame-ancestors answers none beside the frame denial,
# base-uri and form-action stay self, object-src answers none.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# the icon family law of the static domains: icon.svg, svg.icon, icon.ico
# and the png sizes ride every app root — the svg.icon variant carries the
# typed door (image/svg+xml) the deploy lanes serve, the whole family
# immutable at the edge.
/svg.icon
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=31536000, immutable
/icon.svg
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/icon.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/icon192.png
  Cache-Control: public, max-age=31536000, immutable
/icon512.png
  Cache-Control: public, max-age=31536000, immutable
