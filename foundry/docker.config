{
  "meta": {
    "name": "docker.config",
    "title": "foundry - the container configuration of the artifacts site (the compose pair, the nginx face, the site container)",
    "version": "2.0.170",
    "date": "2026-11-06",
    "language": "en",
    "sources": [
      "app:Dockerfile [the foundry site container — solbuild vite stage + the nginx-unprivileged face, EXPOSE 8080, the wget listen healthcheck]",
      "app:docker-compose.yml [the pair: foundry-engine + foundry-face, host 8087:8080, the engine direct lane 3217:8080 unpublished by default]",
      "app:nginx.conf [the vault pattern: resolver 127.0.0.11 valid=10s ipv6=off, location ^~ /api/, the _headers security law, the faun block, the root-emit seal]",
      "app:vite.config.ts [the root-emit outDir law — the hashed bundles land at the application root]",
      "app:package.json [the version stamp the compose args and this manifest carry]",
      "vault:nginx.conf [the reference pattern the family standardizes — the resolver law, the proxy lane, the header law]",
      "saddle:docker.config [the meta format this manifest follows — name, title, version, date, language, sources, mergeReport]",
      "app:onboardingstate.ts [the platform gateway lane the /api proxy carries — the https base law]"
    ],
    "mergeReport": {
      "rootFiles": [
        "Dockerfile",
        "docker-compose.yml",
        "nginx.conf",
        "docker.config"
      ],
      "composeServices": [
        "foundry-engine",
        "foundry-face"
      ],
      "portMap": {
        "face": "8087:8080",
        "engineDirect": "3217:8080 (unpublished by default — the face proxies the private compose network)"
      },
      "healthLane": "the image healthcheck (wget -qO- http://127.0.0.1:8080/) — the listen probe",
      "conflictResolution": "the vault nginx.conf pattern owns the conf law and the saddle docker.config meta format owns this manifest — one owner per law, the family consumes (the engineowners doctrine)",
      "pinPatch": "the family base nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 rides the pattern faces; the static faces ride the registry site image the publish lane stamps"
    }
  },
  "engine": {
    "service": "foundry-engine",
    "surface": "the foundry site container the publish lane builds (the staged family context the Dockerfile reads); the image healthcheck probes the listen port (wget http://127.0.0.1:8080/)",
    "port": "8080",
    "healthcheck": "wget -qO- http://127.0.0.1:8080/ (rides the image)",
    "stateHome": "stateless — the site container carries no store",
    "entry": "the site container (nginx serving the built theme)"
  },
  "face": {
    "service": "foundry-face",
    "image": "ghcr.io/wenathlan/foundry:2.0.170",
    "surface": "the nginx face: the family conf (nginx.conf) mounted over the default site conf of the same foundry image — resolver 127.0.0.11, the _headers security law, gzip, the hashed-asset cache, the ^~ /api proxy lane, the faun and root-emit seals, the try_files spa rewrite",
    "listen": 8080,
    "seals": [
      "the faun db block (403)",
      "the root-emit source seal (403)",
      "the dotfile seal (403)",
      "the tree seal (node_modules, tests, docs, sol — 403)"
    ],
    "spaRewrite": "try_files $uri $uri/ /index.html"
  },
  "apiLane": {
    "route": "/api/*",
    "upstream": "http://foundry-engine:8080",
    "resolver": "127.0.0.11 valid=10s ipv6=off (the docker embedded dns — request-time resolution, the vault law)",
    "body": "client_max_body_size 0 — the engine quota gate is the only ceiling",
    "timeouts": "read 300s / send 300s",
    "carries": "the artifacts console rides the platform gateway lanes through the configured https base (VITE_ONBOARDING_URL) the build stamps; the /api lane carries the same-origin calls to the foundry container"
  },
  "ports": {
    "faceHost": 8087,
    "faceInternal": 8080,
    "engineInternal": 8080,
    "engineDirectCommented": 3217,
    "collisionLaw": "every family face owns one distinct host door (80 for vault, 8081-8090 for the ten siblings) — no two composes ever claim the same host port"
  }
}
