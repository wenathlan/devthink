# devthink gateway replica environment variables
# copy to .env and fill in your values

# database url — sqlite local file or libsql remote
# local sqlite (default for dev)
DATABASE_URL="file:./prisma/devthink.db"
# remote libsql (for vercel netlify production)
# DATABASE_URL="libsql:https://your-turso-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# zai token — required for v1 replica token plus chat id bypass
# get from z ai internal api
ZAI_TOKEN=""

# nvidia api key — required for v3 nvidia nim
# comma separated for 25 key rotation
# get from https://build.nvidia.com
NVIDIA_API_KEY=""

# openrouter api key — required for v5 openrouter free models
# free signup at https://openrouter.ai
OPENROUTER_API_KEY=""

# babel town — v2 paused no key needed
# BABEL_KEY=""
