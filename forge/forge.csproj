<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>forge</AssemblyName>
    <RootNamespace>forge</RootNamespace>
    <PackageId>forge</PackageId>
    <Version>2.0.169</Version>
    <Authors>wenathlan</Authors>
    <Description>Distribution package containing the forge documentation set and the tests directory. forge is the sandbox runner surface — the runners on the saddle engine boundary.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wenathlan/devthink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/devthink</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="docs/**/*" Pack="true" PackagePath="contentFiles/any/any/docs/" />
    <None Include="test/**/*" Pack="true" PackagePath="contentFiles/any/any/test/" />
  </ItemGroup>
</Project>
