# Cadria application build artifacts (this file scopes the application
# tree beside the Sol theme, mirroring the repository-wide contract).
node_modules
dist
distpackage
releasecheck
build
release
Sol/dist
Sol/node_modules
Sol/.vite
*.db
*.db-journal
.env
.env.local
.dev.vars
*.log
coverage

# the generated capacitor shells of the mobile lane (runner-side toolchain output, never committed)
android/
ios/
capacitor.config.json

# the build folder stays hidden from the tree (toolchain output): the workflows generate the icon assets runner-side
build/

# the hashed vite emit lives in the app root (outDir "."): the pages workflow
# rebuilds with VITE_BASE_PATH at deploy, so the content-hashed bundles are
# regenerable output and never enter the tree — index.html points at the
# source entry (./App.tsx), the canonical favicon.svg and the canonical
# manifest.webmanifest stay the only committed web faces.
/index-*.js
/index-*.css
/index-*.wasm
/favicon-*.svg
/favicon-*.png
/favicon-*.ico
/manifest-*.webmanifest
/icon-*.png
/apple-touch-icon*.png
