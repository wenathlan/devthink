{
  "name": "@wenathlan/cadria",
  "version": "2.0.167",
  "private": false,
  "description": "cadria is the video and image player, editor and studio of the wenathlan family: it houses the versawase engine at the folder root, absorbs iukka (player) and create (editor), and imports katexis from debonair and gateway, AI and workflow from devthink. The envelope distributes the documentation set, the zero-build site and the tests directory as one package.",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "vite preview --host",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "restore:entry": "node -e \"const{readFileSync}=require('node:fs');const{execSync}=require('node:child_process');const face=/script[^>]*App\\\\.tsx/;if(face.test(readFileSync('index.html','utf8'))){console.log('index.html already rides the source face');process.exit(0)}if(!face.test(execSync('git show HEAD:./index.html',{encoding:'utf8'}))){console.error('refusing: HEAD index.html is not the source face yet - land the source-face fix first; nothing was touched');process.exit(1)}execSync('git checkout -- index.html',{stdio:'inherit'});console.log('index.html restored from HEAD (the source face)')\""
  },
