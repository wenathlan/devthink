// the cadria typescript baseline.
{
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "paths": {
      "@wenathlan/argan/dns": ["../argan/dns.ts"],

      "@wenathlan/debonair/audio": ["../debonair/audio.ts"],
      "@wenathlan/debonair/audioattributes": ["../debonair/audio.ts"],
      "@wenathlan/debonair/audiodecode": ["../debonair/audio.ts"],
      "@wenathlan/debonair/audiofeatures": ["../debonair/audio.ts"],
      "@wenathlan/debonair/audiopipeline": ["../debonair/audio.ts"],
      "@wenathlan/vault/labelstore": ["../vault/labelstore.ts"],
      "@wenathlan/vault/onboardingstore": ["../vault/onboardingstore.ts"],
      "@wenathlan/vault/storagelane": ["../vault/storagelane.ts"],
      /* the storage lane bridge of the ownership law (the tsconfig arm — the
       * vitest arm already carries the same bridge): the app's sqlite seat
       * (db.ts) rides the vault factory through the published library
       * specifier ("@wenathlan/vault/storage"), and this bridge resolves the
       * specifier to the monorepo source the sibling engine carries — the
       * bootstrap and the helpers are never duplicated inside cadria. the
       * entry retires when the published envelope carries the built storage
       * lane. */
      "@wenathlan/vault/storage": ["../vault/storage.ts"],
      /* the sibling's native dependency bridge: vault/storage.ts imports
       * better-sqlite3, but the vault envelope carries no node_modules of
       * its own and module resolution walks up from the importing file, so
       * the bridge resolves the specifier against THIS app's installed
       * declaration — the engine consumes the app's installs, never a
       * duplicated copy. the entry retires when the sibling envelope
       * carries its own resolvable install. */
      "better-sqlite3": ["./node_modules/@types/better-sqlite3/index.d.ts"],
      "@wenathlan/saddle/security": ["../saddle/security.ts"],
      /* the workload law bridge of the family: the app's sandbox lane seat
       * answers the engine catalog rows through the published specifier
       * ("@wenathlan/saddle/workloadlaw"), and this bridge resolves the
       * specifier to the monorepo source the sibling engine carries — the
       * mirror era is over, the rows are the owner's own objects. the
       * entry retires when the published envelope carries the built
       * workload law. */
      "@wenathlan/saddle/workloadlaw": ["../saddle/workloadlaw.ts"],
      /* the gateway thinking bridge of the ownership law: devthink/os.ts and
       * the family seats reach the reasoning ladder through the published
       * specifier ("@wenathlan/getry/thinking"), and this bridge resolves it
       * to the monorepo source the gateway engine owns — the thinking seat is
       * never duplicated inside cadria. */
      "@wenathlan/getry/thinking": ["../getry/thinking.ts"],
      /* the babel lane bridge: saddle/modalities.ts imports @babel/core
       * through a guarded dynamic import, and devthink carries the typed
       * face ("babelcoreface.ts") the whole family resolves against — the
       * engine consumes the typed face, never a duplicated copy. */
      "@babel/core": ["../devthink/babelcoreface.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "sol/**/*.ts", "sol/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
