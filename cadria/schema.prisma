// # cadria schema — declarative data model of the video, image and 3D studio
// self-hosted stack: sqlite through DATABASE_URL. The browser data layer (catalog.ts)
// serves the same tables; drizzle.config.ts inside this theme points the raw ORM at
// the same database.
//
// family sync contract (devthink master): a table of the same kind carries
// the same columns and the same pointers in every application that holds
// the kind — identity pointers are text, counts are 32-bit ints, time is
// datetime or iso text, and byte-scale pointers (sizes, lengths, offsets)
// are 64-bit BigInt, the pointer that holds terabytes. The sqlite
// autoincrement rowid is 64-bit by the engine contract. This file is the
// documentation of record: the runtime runs drizzle + better-sqlite3
// beside it and mirrors the same columns in its boot DDL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// a project of the studio workspace (a gallery card, openable back into its anchor)
model Project {
  // discipline "generation" — wave 3 extends this studio with the audio→image
  // generation pipeline (AudioAnalysis + ImageGeneration below); this model
  // itself is untouched, the note documents the new discipline only.
  id         String      @id @default(cuid())
  title      String
  discipline String      // video | image | 3d
  format     String      // mp4 | hls | png | webp | glb | obj
  tone       String      @default("default")
  art        Int         @default(1)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  assets     Asset[]
  jobs       RenderJob[]
}

/// one media asset of a project (video cut, image composite, 3D scene) —
/// the byte pointer is the family-canonical 64-bit BigInt size
model Asset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  kind      String   // video | image | 3d | audio | document
  extension String   // .mp4 | .m3u8 | .png | .glb
  size      BigInt   @default(0)
  hash      String?

  @@index([projectId])
}

/// one render of the family queue — the same table and pointers cadria and
/// debonair carry (the render kind is synced across both studios)
model RenderJob {
  id        String    @id @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  trackId   String?
  prompt    String    @default("")
  genre     String    @default("")
  seed      Int       @default(0)
  duration  String    @default("")
  status    String    @default("queued") // queued | rendering | ready
  seconds   Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([projectId])
}

/// one row of the universal player format table (engines from the real manifest)
model PlayerFormat {
  id         String  @id @default(cuid())
  format     String
  media      String
  engine     String
  tone       String  @default("default")
  status     String  @default("planned")
  extensions String
}

// — the generation pipeline (wave 3): both models carry exactly the columns of
// the generation.ts storage seam (GenerationRecord / AnalysisRecord) and follow
// the family sync contract above: identity pointers are text, counts are
// 32-bit ints, time is datetime, and the byte-scale JSON payloads are capped
// at 512 KiB by the runtime seam. The caller supplies the id and the createdAt
// (deterministic save — no engine defaults), so no @default attributes.

/// one analysis of a source audio (the audiopipeline AnalysisReport snapshot)
model AudioAnalysis {
  id         String   @id
  sourceKind String
  sampleRate Int
  durationMs Int
  bpm        Int      // clamped 20–300 by the seam
  keyName    String
  reportJson String   // byte-scale payload, 512 KiB cap
  createdAt  DateTime

  @@index([createdAt])
}

/// one audio→image generation of the studio (ImageProject + svg digest)
model ImageGeneration {
  id             String   @id
  seed           String
  style          String
  bpm            Int      // clamped 20–300 by the seam
  keyTonic       Int
  keyMode        String
  durationMs     Int
  descriptorJson String   // byte-scale payload, 512 KiB cap
  projectJson    String   // byte-scale payload, 512 KiB cap
  svgDigest      String
  createdAt      DateTime

  @@index([createdAt])
}
