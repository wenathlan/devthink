{
  "name": "@wenathlan/devthink",
  "version": "2.0.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenathlan/devthink"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.23.1"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "0.17.4",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "hono": "^4.13.7",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "bun-types": "^1.4.2",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0",
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.9.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "@opencode-ai/sdk": "^1.18.30",
    "tsup": "^8.5.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.neutral.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js",
      "default": "./dist/progress.js"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "require": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./umd": {
      "types": "./dist/umd.d.ts",
      "default": "./dist/devthink.umd.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "require": "./dist/node.cjs"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "default": "./dist/bridge.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js",
      "default": "./dist/pack.js"
    },
    "./crossbrowser": {
      "types": "./dist/crossbrowser.d.ts",
      "import": "./dist/crossbrowser.js",
      "default": "./dist/crossbrowser.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "devthink": "./dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/wenathlan/devthink/issues"
  },
  "description": "DevThink is the merged AI development workbench: the provider-owned gateway engine, the DevThink browser extension (the agent surface), the Antigravity engine and the workbench CLI — one product, one binary, one metadata.",
  "engines": {
    "bun": ">=1.4.2 <2",
    "node": ">=26.8.2 <27",
    "npm": ">=12.0.2 <13",
    "deno": ">=2.0.0 <3"
  },
  "files": [
    "*.ts",
    "*.tsx",
    "web/extension/",
    "web/gatewayview/",
    "web/schema.prisma",
    "tests/build.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/schemas/antigravity.json"
  ],
  "homepage": "https://wenathlan.github.io/devthink/",
  "keywords": [
    "ai",
    "cli",
    "developer-tools",
    "llm",
    "streaming",
    "terminal",
    "provider-endpoints",
    "embedded-gateway",
    "web-workbench"
  ],
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "bun run devthink.ts",
    "dev": "bun --watch run devthink.ts",
    "test": "vitest run",
    "check": "bun run check:secrets && bun run test",
    "check:secrets": "bun run checksecrets.ts",
    "build:binary": "bun run build.ts",
    "build": "node tests/build.mjs",
    "release": "bun run check && bun run build",
    "test:node": "node --experimental-strip-types --test tests/core.test.ts tests/provider/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:metadata": "node tests/release.mjs sync",
    "check:metadata": "node tests/release.mjs check",
    "sync:maintenance": "node tests/maintain.mjs sync",
    "check:maintenance": "node tests/maintain.mjs check",
    "dependency:updates": "node tests/dependencyupdates.mjs sync",
    "workflow:updates": "node tests/workflowupdates.mjs sync",
    "notes:release": "node tests/release.mjs notes",
    "validate:runtime": "node tests/runtimepolicy.mjs",
    "validate:workflow": "node tests/workflowcheck.mjs && node tests/npmgate.mjs",
    "validate:apifreeze": "node tests/apifreeze.mjs",
    "validate:security": "node tests/pentest.mjs && node tests/cspaudit.mjs && node tests/permdiff.mjs",
    "validate:agents": "node tests/agentcert.mjs && node tests/costcert.mjs",
    "apifreeze:sync": "node tests/apifreeze.mjs sync",
    "test:chromium": "node tests/chromiumsmoke.mjs",
    "validate": "pnpm check:metadata && pnpm validate:runtime && pnpm check && pnpm build && pnpm validate:security && pnpm validate:agents && pnpm validate:workflow && pnpm validate:apifreeze && pnpm validate:docs && pnpm validate:candidate && node tests/recipes.mjs && pnpm test && node dist/cli.js manifest && node dist/cli.js help && node tests/packageextension.mjs",
    "package": "pnpm build && npm pack ./distpackage --dry-run",
    "pack:check": "npm pack --dry-run",
    "permdiff:sync": "node tests/permdiff.mjs sync",
    "validate:docs": "node tests/doccheck.mjs",
    "validate:candidate": "node tests/sweep.mjs && node tests/poolaudit.mjs && node tests/matrixverify.mjs && node tests/telemetryfree.mjs && node tests/soak.mjs && node tests/wcag.mjs",
    "build:web": "pnpm --dir web build",
    "dev:web": "pnpm --dir web dev",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "server": "tsx server.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "formatcheck": "biome format .",
    "provider": "tsx devthink.ts provider",
    "antigravity": "bun --watch llm.ts"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false
}
