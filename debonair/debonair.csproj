<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>debonair</AssemblyName>
    <RootNamespace>debonair</RootNamespace>
    <PackageId>debonair</PackageId>
    <Version>2.0.181</Version>
    <Authors>wenathlan</Authors>
    <Description>Distribution package containing the debonair documentation set, the zero-build site and the tests directory. debonair is the audio and DAW app; it houses the katexis engine at the folder root.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wenathlan/devthink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/devthink</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="docs/**/*" Pack="true" PackagePath="contentFiles/any/any/docs/" />
    <None Include="site/**/*" Pack="true" PackagePath="contentFiles/any/any/site/" />
    <None Include="test/**/*" Pack="true" PackagePath="contentFiles/any/any/test/" />
  </ItemGroup>
