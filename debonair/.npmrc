engine-strict=false
cache-integrity=true
prefer-online=true
fetch-retries=5
save-exact=false
save-prefix=^
prefer-dedupe=true
fund=false
audit=true
loglevel=warn

# the family scope resolves from the public npmjs registry (the
# install lanes fetch the sibling envelopes the npmjs rungs carry — the
# 2.0.181 wall the github registry never answered); every publish step
# passes its registry explicitly, so the scoped seat never touches them.
@wenathlan:registry=https://registry.npmjs.org
