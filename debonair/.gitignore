# Debonair application build artifacts (this file scopes the application
# tree beside the Sol theme, mirroring the repository-wide contract).
node_modules
dist
distpackage
releasecheck
build
release
Sol/dist
Sol/node_modules
Sol/.vite
*.db
*.db-journal
.env
.env.local
.dev.vars
*.log
coverage

# the generated capacitor shells of the mobile lane (runner-side toolchain output, never committed)
android/
ios/
capacitor.config.json

# the build folder stays hidden from the tree (toolchain output): the workflows generate the icon assets runner-side
build/

# the hashed emit of the vite build lands beside the sources (outDir ".", emptyOutDir
# false): the pages workflow rebuilds per deploy, so the hashed faces never enter the
# tree — only the canonical unhashed files (index.html source face, favicon.svg,
# manifest.webmanifest, icon.svg) stay tracked
/index-*.js
/index-*.css
/favicon-*.svg
/favicon-*.png
/favicon-*.ico
/manifest-*.webmanifest
/icon-*.png
/apple-touch-icon*.png
/registerSW-*.js
/sw.js
# the self-hosted variable faces the fontsource emit copies to the root (hashed)
/*.woff2
