# debonair daw environment variables
# copy to .env and fill in your values

# database url — sqlite local file or libsql remote
# local sqlite (default for dev)
DATABASE_URL="file:./local.db"
# remote libsql (for vercel netlify production)
# DATABASE_URL="libsql:https://your-turso-db.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# the blob backend seat — which lane holds the pipeline blobs (memory,
# file, gateway or vault; the deploy decides, the memory mirror is the
# offline default)
# DEBONAIR_BLOB_BACKEND="vault"
# the root directory of the file lane (the git-lfs shard layout on disk)
# DEBONAIR_BLOB_ROOT="/var/lib/debonair/blobs"
# the gateway origin of the gateway lane (https, a public host)
# DEBONAIR_URL="https://gateway.example.com"

# the vault lane (the family storage engine behind the blob pointers) —
# the origin of the vault storage surface, the bearer the operator pinned
# (the faun lesson) and the project scope the deposits ride
# DEBONAIR_VAULT_URL="https://vault.example.com"
# VAULT_TOKEN="the-operator-pinned-token"
# DEBONAIR_VAULT_PROJECT="debonair"

# the sandbox modality the heavy worker lanes declare (opt-in per deploy):
# "local" (the deploy's own process, the honest default) or one of the
# saddle modality ids — runner-node, container-docker, microvm-firecracker
# — the platform resolves the sandbox, the workers never spawn anything
# DEBONAIR_WORKER_MODALITY="local"

# the gateway origin the browser lanes ride (the bench, the clients —
# https, a public host; vite folds it into the build)
# VITE_DEBONAIR_URL="https://gateway.example.com"
