// the stealthhead typescript baseline (the web theme compilerOptions over the
// game logics: one project covers the app root and the Sol theme).
{
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./sol/*", "./*"],
      "@wenathlan/devthink/personalstore": ["../devthink/personalstore.ts"],
      "@wenathlan/devthink/reveal": ["../devthink/reveal.ts"],
      "@wenathlan/saddle/workloadlaw": ["../saddle/workloadlaw.ts"],
      "@wenathlan/vault/labelstore": ["../vault/labelstore.ts"],
      "@wenathlan/vault/storage": ["../vault/storage.ts"],
      /* the storagelane bridge of the ownership law: the game store (db.ts)
       * rides the vault sqlite factory owner through the published library
       * specifier ("@wenathlan/vault/storagelane" — the keyed file the
       * wave/db-vault-subpath seat owns), and this bridge resolves the
       * specifier to the monorepo source the sibling engine carries. the
       * entry retires when the published envelope carries the built
       * storage lane owner. */
      "@wenathlan/vault/storagelane": ["../vault/storagelane.ts"]
    }
  },
  "include": ["*.ts", "*.tsx", "sol/**/*.ts", "sol/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "tests"]
}
