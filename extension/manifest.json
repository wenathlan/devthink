{
  "manifest_version": 3,
  "name": "DevThink Workbench",
  "version": "1.1.10",
  "description": "Local-first DevThink workbench that pairs explicitly with a local gateway.",
  "action": {
    "default_title": "Open DevThink"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
