<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>DevThink</PackageId>
    <Version>1.1.15</Version>
    <Authors>wenathlan</Authors>
    <Description>.NET process adapter for the DevThink CLI.</Description>
    <PackageProjectUrl>https://github.com/wenathlan/devthink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/devthink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>devthink;cli;ai;development</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DevThinkCli.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
