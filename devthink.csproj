<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>DevThink</PackageId>
    <Version>2.0.0</Version>
    <Authors>wenathlan</Authors>
    <Description>.NET process adapter for the DevThink CLI (the 2.0.0 grand merge: the gateway engine, the DevThink extension surface and the Antigravity engine ride one binary).</Description>
    <PackageProjectUrl>https://github.com/wenathlan/devthink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/devthink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>devthink;cli;ai;development;browser-extension;agent;antigravity;gateway;llm</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DevThinkCli.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
