{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": ".",
  "build": {
    "env": {
      "VITE_VAULT_URL": "https://vault-engine.example.org"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
