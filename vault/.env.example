# vault storage environment variables
# copy to .env and fill in your values

# storage url — sqlite local file of the storage engine (drizzle.ts reads it)
# local sqlite (default for dev)
VAULT_STORAGE_URL="file:./vault-storage.db"

# the mysql seam — when MYSQL_URL answers, the engine refuses loudly until
# the mysql2 rung lands (clear it to ride the sqlite path today)
# MYSQL_URL=""

# the bearer token every storage route of api.ts demands (the faun lesson:
# the network database never answers without it). pin a long random value;
# callers present it as "Authorization: Bearer <token>" or "x-vault-token".
# the operator lane only — the person lane rides the session cookie and the
# application lane rides the x-api-key header (accounts.ts).
VAULT_TOKEN=""

# the faun lesson deny-list: extra extensions (csv) the download lane
# refuses beside the pinned .db/.sqlite/.sqlite3/.db-wal — default empty.
# VAULT_DB_LOCKLIST="accdb,mdb"

# the listen port and host of the vault http surface
# VAULT_PORT="3210"
# VAULT_HOST="0.0.0.0"
