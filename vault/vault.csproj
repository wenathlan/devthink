<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>vault</AssemblyName>
    <RootNamespace>vault</RootNamespace>
    <PackageId>vault</PackageId>
    <Version>2.0.162</Version>
    <Authors>wenathlan</Authors>
    <Description>Distribution package containing the vault documentation set and the tests directory. vault is the supabase clone — the self-hosted database, auth and storage surface.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wenathlan/devthink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/devthink</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="docs/**/*" Pack="true" PackagePath="contentFiles/any/any/docs/" />
    <None Include="tests/**/*" Pack="true" PackagePath="contentFiles/any/any/tests/" />
  </ItemGroup>
</Project>
