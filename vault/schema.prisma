// vault prisma schema — the self-hosted database of the supabase clone:
// projects, accounts and storage objects, all served over https.
//
// family sync contract (devthink master): a table of the same kind carries
// the same columns and the same pointers in every application that holds
// the kind — identity pointers are text, counts are 32-bit ints, time is
// datetime or iso text, and byte-scale pointers (sizes, lengths, offsets)
// are 64-bit BigInt, the pointer that holds terabytes. The sqlite
// autoincrement rowid is 64-bit by the engine contract. This file is the
// documentation of record: the runtime runs drizzle + better-sqlite3
// beside it and mirrors the same columns in its boot DDL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  region    String   @default("local")
  createdAt DateTime @default(now())
  objects   StorageObject[]
}

model Account {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String   @default("owner")
  createdAt DateTime @default(now())
}

model StorageObject {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  path      String
  lfs       Boolean  @default(false)
  size      BigInt   @default(0)
  createdAt DateTime @default(now())
}

/// the onboarding state of one visitor — the entry-flow gates catalogued on
/// the database (intro → onboarding → the platform): the browser accessor
/// (onboardingstate.ts) rides GET/POST /api/v1/onboarding against this table,
/// the sqlite mirror lives in db.ts (onboarding_states)
model OnboardingState {
  id             Int      @id @default(autoincrement())
  visitor        String   @unique
  introseen      Boolean  @default(false)
  onboardingseen Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}
