// vault prisma schema — the self-hosted database of the supabase clone:
// projects, accounts (the identity pass: signup, sessions, project api
// keys) and the storage engine (ledger objects, the 256KB chunk catalog,
// the ordered chunk references and the user-defined quotas), all served
// over https by the drizzle executor.
//
// family sync contract (devthink master): a table of the same kind carries
// the same columns and the same pointers in every application that holds
// the kind — identity pointers are text, counts are 32-bit ints, time is
// datetime or iso text, and byte-scale pointers (sizes, limits, chunk
// lengths) are 64-bit BigInt, the pointer that holds terabytes. The sqlite
// rowid is 64-bit by the engine contract. This file is the documentation of
// record (prisma only declares): the runtime executes drizzle + better-
// sqlite3 beside it and mirrors the same columns in its boot DDL — no .sql
// lives in the repo, migrations stay gitignored and CI-only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String         @id @default(cuid())
  name           String
  region         String         @default("local")
  /// the owning account — null while the operator bootstrap owns the scope
  ownerAccountId String?        @map("owner_account_id")
  owner          Account?       @relation(fields: [ownerAccountId], references: [id])
  createdAt      DateTime       @default(now())
  objects        StorageObject[]
  apiKeys        ApiKey[]
  quota          Quota?

  @@map("projects")
}

/// the person identity of the vault — the supabase law: a person signs up,
/// signs in and registers applications. the password rides scrypt (the
/// stored shape "scrypt$salt$hash"), the createdAt pointer is bigint epoch
/// milliseconds (the runtime drizzle cell is INTEGER ms).
model Account {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("owner")
  createdAt     BigInt    @map("created_at")
  sessions      Session[]
  ownedProjects Project[]

  @@map("accounts")
}

/// one signed-in person row — only the sha-256 hash of the cookie token
/// lands (token_hash), the raw token answers once in the httpOnly
/// vaultsession cookie and never rides the database. expires_at is bigint
/// epoch milliseconds; the login sweep collects the expired rows.
model Session {
  tokenHash String  @id @map("token_hash")
  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id])
  expiresAt BigInt  @map("expires_at")
  createdAt BigInt  @map("created_at")

  @@map("sessions")
}

/// one project api key — the application lane: the row keeps the sha-256 of
/// the raw key (answered once at issuance), the readable prefix the console
/// shows, the last-use instant and the revocation instant (a revoked key
/// refuses without erasing its history).
model ApiKey {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id])
  keyHash    String   @unique @map("key_hash")
  prefix     String
  lastUsedAt BigInt?  @map("last_used_at")
  revokedAt  BigInt?  @map("revoked_at")
  createdAt  BigInt   @map("created_at")

  @@map("apikeys")
}

/// one ledger row per stored object — the path, the mime, the real sha-256
/// digest, the json manifest (the ordered chunk truth) and the bigint size
/// pointer. deleted_at is the soft-delete tombstone; the sweep collects the
/// tombstones and the orphan chunks no one references anymore.
model StorageObject {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  path      String
  mime      String
  size      BigInt     @default(0)
  digest    String
  /// the json manifest as text — the ordered chunk entries, the channel, the tier
  manifest  String
  channel   String     @default("blob")
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  chunkRefs ChunkRef[]

  @@map("storage_objects")
}

/// the content-addressed chunk catalog — one row per unique 256KB window,
/// keyed by its real sha-256, refcounted (refs = live chunk_refs rows).
/// the bytes column is the bytea law: blobs never ride the db raw, only
/// their packed 256KB windows do.
model Chunk {
  id        BigInt      @id @default(autoincrement())
  digest    String      @unique
  size      BigInt
  stored    BigInt
  encoding  String      @default("raw")
  refs      Int         @default(0)
  bytes     Bytes
  createdAt DateTime    @default(now())
  pointers  ChunkRef[]

  @@map("chunks")
}

/// the ordered edge between an object and its chunks — position is the
/// reassembly order inside the object.
model ChunkRef {
  objectId String       @map("object_id")
  position Int
  chunkId  BigInt       @map("chunk_id")
  object   StorageObject @relation(fields: [objectId], references: [id])
  chunk    Chunk        @relation(fields: [chunkId], references: [id])

  @@id([objectId, position])
  @@map("chunk_refs")
}

/// the user-defined quota of one project — limit_bytes is bigint and null
/// means unlimited: no fixed cap exists anywhere in the vault, the 900MB
/// floor only answers at project creation until the owner redefines it.
model Quota {
  projectId  String   @id @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id])
  limitBytes BigInt?   @map("limit_bytes")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("quotas")
}

/// the onboarding state of one visitor — the entry-flow gates catalogued on
/// the database (intro → onboarding → the platform): the browser accessor
/// (onboardingstate.ts) rides GET/POST /api/v1/onboarding against this table,
/// the sqlite mirror lives in db.ts (onboarding_states)
model OnboardingState {
  id             Int      @id @default(autoincrement())
  visitor        String   @unique
  introseen      Boolean  @default(false)
  onboardingseen Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("onboarding_states")
}
