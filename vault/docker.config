{
  "meta": {
    "name": "docker.config",
    "title": "vault - the container configuration of the storage engine (the reference compose pair, the reference nginx face, the storage engine)",
    "version": "2.0.170",
    "date": "2026-11-06",
    "language": "en",
    "sources": [
      "app:Dockerfile [the engine container — node api.ts, /api/health, EXPOSE 3210]",
      "app:docker-compose.yml [the pair: engine + face, host 80:8080, the engine direct lane 8080:8080 unpublished by default]",
      "app:nginx.conf [the vault pattern: resolver 127.0.0.11 valid=10s ipv6=off, location ^~ /api/, the _headers security law, the faun block, the root-emit seal]",
      "app:vite.config.ts [the root-emit outDir law — the hashed bundles land at the application root]",
      "app:package.json [the version stamp the compose args and this manifest carry]",
      "vault:nginx.conf [the reference pattern the family standardizes — the resolver law, the proxy lane, the header law]",
      "saddle:docker.config [the meta format this manifest follows — name, title, version, date, language, sources, mergeReport]"
    ],
    "mergeReport": {
      "rootFiles": [
        "Dockerfile",
        "docker-compose.yml",
        "nginx.conf",
        "docker.config"
      ],
      "composeServices": [
        "engine",
        "face"
      ],
      "portMap": {
        "face": "80:8080",
        "engineDirect": "8080:8080 (unpublished by default — the face proxies the private compose network)"
      },
      "healthLane": "the image healthcheck (wget /api/health on VAULT_PORT)",
      "conflictResolution": "the vault nginx.conf pattern owns the conf law and the saddle docker.config meta format owns this manifest — one owner per law, the family consumes (the engineowners doctrine)",
      "pinPatch": "the family base nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6 rides the pattern faces; the static faces ride the registry site image the publish lane stamps"
    }
  },
  "engine": {
    "service": "engine",
    "surface": "the vault storage engine: node api.ts on VAULT_PORT (8080 in the compose pair, 3210 the image default), the /api/health probe the image healthcheck rides, the sealed ledger on the vaultdata volume",
    "port": "VAULT_PORT (8080 in the compose pair, 3210 the image default)",
    "healthcheck": "wget /api/health (rides the image)",
    "stateHome": "vaultdata:/data (the sealed ledger)",
    "entry": "the storage engine (node api.ts, /api/health, VAULT_PORT 8080 in the pair)"
  },
  "face": {
    "service": "face",
    "image": "the vault face (the reference compose)",
    "surface": "the nginx face: the family conf (nginx.conf) the reference owns — the /api proxy lane to the engine upstream, the faun block, the spa rewrite",
    "listen": 8080,
    "seals": [
      "the faun db block (403)",
      "the root-emit source seal (403)",
      "the dotfile seal (403)",
      "the tree seal (node_modules, tests, docs, sol — 403)"
    ],
    "spaRewrite": "try_files $uri $uri/ /index.html"
  },
  "apiLane": {
    "route": "/api/*",
    "upstream": "http://engine:8080",
    "resolver": "127.0.0.11 valid=10s ipv6=off (the docker embedded dns — request-time resolution, the vault law)",
    "body": "client_max_body_size 0 — the engine quota gate is the only ceiling",
    "timeouts": "read 300s / send 300s",
    "carries": "the storage calls the vault client lanes demand"
  },
  "ports": {
    "faceHost": 80,
    "faceInternal": 8080,
    "engineInternal": 8080,
    "engineDirectCommented": 8080,
    "collisionLaw": "every family face owns one distinct host door (80 for vault, 8081-8090 for the ten siblings) — no two composes ever claim the same host port"
  }
}
